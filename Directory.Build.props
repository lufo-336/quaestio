<Project>

  <!-- Versione unica per tutti i progetti della solution (step 14).
       La schermata About la legge a runtime dall'assembly, cosi' non c'e'
       un numero da tenere allineato a mano in due posti.
       Android e iOS prendono da qui anche il numero mostrato dal sistema
       (ApplicationDisplayVersion = $(Version) nei loro csproj); il contatore
       intero ApplicationVersion resta nei csproj e va aumentato di 1 a ogni
       APK/IPA pubblicato, altrimenti l'aggiornamento non si installa sopra.
       Regola: terzo numero = correzioni, secondo = funzioni nuove. -->
  <PropertyGroup>
    <Version>2.3.0</Version>
  </PropertyGroup>

</Project>
