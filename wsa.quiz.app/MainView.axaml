<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:c="using:Wsa.Quiz.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.MainView"
             Background="{DynamicResource Sfondo}"
             Foreground="{DynamicResource TestoPrincipale}">

    <UserControl.Styles>
        <!-- Pulsanti della bottom navigation C2 (touch): campi di colore pieni
             assegnati in code-behind da Inchiostri; inattivo = solo icona,
             attivo = icona + nome sezione nella colonna allargata (2.8*). -->
        <Style Selector="Button.nav">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.nav.attiva">
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}"/>
        </Style>
        <!-- Icone stile Lucide (viewBox 24, stroke 2). -->
        <Style Selector="Button.nav Path">
            <!-- Stretch None: la geometria usa le coordinate del viewBox 24x24 cosi'
                 com'e', quindi tutte le icone hanno lo stesso peso visivo. -->
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav TextBlock">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontTitoli}"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style Selector="Button.nav.attiva TextBlock">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <DockPanel x:Name="RootDock">

        <!-- Header -->
        <Border x:Name="HeaderBorder"
                DockPanel.Dock="Top"
                Background="{DynamicResource Sfondo}"
                BorderBrush="{DynamicResource RigaForte}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <c:MarchioQuaestio Height="28"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="StatoHeaderText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TestoAttenuato}"/>
            </Grid>
        </Border>

        <!-- Footer diagnostico (desktop). Nascosto su touch in code-behind. -->
        <Border x:Name="FooterBar"
                DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource RigaDebole}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <TextBlock x:Name="FooterText"
                       FontSize="11"
                       Foreground="{DynamicResource TestoAttenuato}"/>
        </Border>

        <!-- Errore globale (visibile solo se il caricamento dati fallisce) -->
        <Border x:Name="ErrorePanel"
                DockPanel.Dock="Top"
                Background="#F9E4E6"
                BorderBrush="{DynamicResource RossoBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                IsVisible="False">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static r:Strings.Shell_ErroreCaricamento}"
                           FontWeight="SemiBold"
                           Foreground="#000000"/>
                <TextBlock x:Name="ErroreText"
                           FontSize="12"
                           Foreground="#000000"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Cella unica di riempimento: desktop usa il TabControl (tab in alto), touch
             usa SwipeHost, uno ScrollViewer orizzontale con snap. La visibilità è
             impostata in ConfiguraNavigazione secondo AppEnv.TouchMode; i due host non
             sono mai visibili insieme. -->
        <Grid>
            <TabControl x:Name="Tabs" Padding="0">
                <TabItem Header="{x:Static r:Strings.Shell_TabHome}">
                    <ContentControl x:Name="HomeArea"/>
                </TabItem>
                <TabItem Header="{x:Static r:Strings.Shell_TabCronologia}">
                    <ContentControl x:Name="CronologiaArea"/>
                </TabItem>
                <TabItem Header="{x:Static r:Strings.Shell_TabSospesi}">
                    <ContentControl x:Name="SospesiArea"/>
                </TabItem>
                <TabItem Header="{x:Static r:Strings.Shell_TabStatistiche}">
                    <ContentControl x:Name="StatisticheArea"/>
                </TabItem>
                <TabItem Header="{x:Static r:Strings.Shell_TabGestione}">
                    <ContentControl x:Name="GestioneArea"/>
                </TabItem>
                <TabItem Header="{x:Static r:Strings.Shell_TabImpostazioni}">
                    <ContentControl x:Name="ImpostazioniArea"/>
                </TabItem>
            </TabControl>

            <!-- Touch: le 4 pagine affiancate in orizzontale, ciascuna larga quanto il
                 viewport (impostato in code-behind). Lo scroll orizzontale nativo dà
                 trascinamento col dito + inerzia; HorizontalSnapPointsType=MandatorySingle
                 fa agganciare a una pagina per volta (feeling pager/Instagram). Lo scroll
                 verticale è disabilitato qui: ogni pagina ha il proprio ScrollViewer
                 interno, quindi gli assi non si pestano. -->
            <ScrollViewer x:Name="SwipeHost" IsVisible="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalSnapPointsType="MandatorySingle"
                          HorizontalSnapPointsAlignment="Near">
                <StackPanel x:Name="SwipePages" Orientation="Horizontal">
                    <ContentControl x:Name="HomeAreaTouch"/>
                    <ContentControl x:Name="CronologiaAreaTouch"/>
                    <ContentControl x:Name="SospesiAreaTouch"/>
                    <ContentControl x:Name="StatisticheAreaTouch"/>
                    <ContentControl x:Name="GestioneAreaTouch"/>
                    <ContentControl x:Name="ImpostazioniAreaTouch"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom navigation C2 (touch): barra a tutta larghezza, a filo del
                 bordo inferiore sopra l'inset Android (padding da ApplicaSafeArea).
                 Sei campi di colore pieni (da Inchiostri); l'attivo si allarga a
                 2.8* mostrando icona + nome della sezione. La sua altezza reale
                 diventa SzRiservaNav, cosi' l'ultimo contenuto di ogni pagina scorre
                 sopra la barra invece di restarne coperto. -->
            <Border x:Name="BottomNav"
                    IsVisible="False"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource Sfondo}">
                <Grid x:Name="NavGrid"
                      Height="56"
                      ColumnDefinitions="*,*,*,*,*,*">
                    <Button x:Name="NavHome" Grid.Column="0" Classes="nav" Tag="0" Click="OnNavClick"
                            AutomationProperties.Name="{x:Static r:Strings.Shell_TabHome}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8 M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Shell_TabHome}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavCronologia" Grid.Column="1" Classes="nav" Tag="1" Click="OnNavClick"
                            AutomationProperties.Name="{x:Static r:Strings.Shell_TabCronologia}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M12 7v5l4 2"/>
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Shell_TabCronologia}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavSospesi" Grid.Column="2" Classes="nav" Tag="2" Click="OnNavClick"
                            AutomationProperties.Name="{x:Static r:Strings.Shell_TabSospesi}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M2 12 A10 10 0 1 0 22 12 A10 10 0 1 0 2 12 Z M10 15V9 M14 15V9"/>
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Shell_TabSospesi}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavStatistiche" Grid.Column="3" Classes="nav" Tag="3" Click="OnNavClick"
                            AutomationProperties.Name="{x:Static r:Strings.Shell_TabStatistiche}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M3 3v16a2 2 0 0 0 2 2h16 M18 17V9 M13 17V5 M8 17v-3"/>
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Shell_TabStatistiche}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavGestione" Grid.Column="4" Classes="nav" Tag="4" Click="OnNavClick"
                            AutomationProperties.Name="{x:Static r:Strings.Shell_TabGestione}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z M12 10v6 M9 13h6"/>
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Shell_TabGestione}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="NavImpostazioni" Grid.Column="5" Classes="nav" Tag="5" Click="OnNavClick"
                            AutomationProperties.Name="{x:Static r:Strings.Shell_TabImpostazioni}">
                        <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 Z"/>
                            <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Shell_TabImpostazioni}"/>
                        </Grid>
                    </Button>
                </Grid>
            </Border>
        </Grid>

    </DockPanel>

</UserControl>
