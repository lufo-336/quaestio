<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Wsa.Quiz.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Wsa.Quiz.App/Themes/Sizes.Desktop.axaml"/>
                <ResourceInclude Source="avares://Wsa.Quiz.App/Themes/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            <!-- Angoli vivi (raggio 0): override delle risorse Fluent. -->
            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
            <SolidColorBrush x:Key="AccentoBrush" Color="#3a6cb8"/>
            <SolidColorBrush x:Key="AccentoHoverBrush" Color="#4E7BBF"/>
            <SolidColorBrush x:Key="AccentoPressedBrush" Color="#2E5693"/>
            <SolidColorBrush x:Key="AccentoTestoBrush" Color="#FFFFFF"/>

            <!-- Codice nelle domande (TestoConCodice). Font incluso nell'app
                 (JetBrains Mono NL = senza legature: "!=" resta "!=") cosi' e'
                 uguale ovunque, anche su WebAssembly che non ha font di sistema.
                 Colori per tema: riquadro chiaro nel tema chiaro, tipo editor
                 nel tema scuro. Brush, non Color (trappola 7). -->
            <FontFamily x:Key="FontCodice">avares://Wsa.Quiz.App/Assets/Fonts#JetBrains Mono NL</FontFamily>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CodiceSfondo" Color="#F3F4F6"/>
                    <SolidColorBrush x:Key="CodiceBordo" Color="#DADDE2"/>
                    <SolidColorBrush x:Key="CodiceTesto" Color="#1F1F1F"/>
                    <SolidColorBrush x:Key="CodiceNumeri" Color="#8A8F99"/>
                    <!-- semitrasparente: leggibile anche sui bottoni verdi/rossi -->
                    <SolidColorBrush x:Key="ChipSfondo" Color="#1A000000"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CodiceSfondo" Color="#1E1F24"/>
                    <SolidColorBrush x:Key="CodiceBordo" Color="#2E3038"/>
                    <SolidColorBrush x:Key="CodiceTesto" Color="#E6E6E6"/>
                    <SolidColorBrush x:Key="CodiceNumeri" Color="#6C7080"/>
                    <SolidColorBrush x:Key="ChipSfondo" Color="#26FFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!--
          Stile per i bottoni con azione "primaria" (Avvia quiz, Torna alla Home, ...).
          Risolve la trappola n.6 della handoff: in Fluent il bottone con
          Background=SystemAccentColorBrush, andando in IsEnabled=false, mantiene
          un colore quasi bianco e si confonde con lo sfondo.
          Qui definiamo i quattro stati (default, hover, pressed, disabled) sul
          ContentPresenter del template. I bottoni applicabili usano Classes="accent".
        -->
        <!-- Sfondi via DynamicResource a brush applicativi (AccentoBrush), NON
             DynamicResource SystemAccentColorBrush: su Android quel resource puo'
             risolversi in un colore invisibile (bianco/trasparente), rendendo il bottone
             abilitato invisibile (testo bianco su bianco). Vedi Trappola 6/20.
             I brush sono impostati dinamicamente da Tavolozza.Applica. -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoHoverBrush}"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoPressedBrush}"/>
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <!-- Grigio neutro: contrasto su sfondo chiaro senza essere "vivo".
                 Valori espliciti (non DynamicResource Color) per stare al sicuro
                 dalle conversioni Color->Brush nei Setter. -->
            <Setter Property="Background" Value="#D6D6D6"/>
            <Setter Property="Foreground" Value="#7A7A7A"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
        </Style>

        <!-- Pulsanti accendi/spegni del riquadro "Tipo di domande" (Home). Acceso =
             colore d'accento dell'utente, per lo stesso motivo di Button.accent
             (Trappola 20): niente SystemAccentColorBrush del tema Fluent. -->
        <Style Selector="ToggleButton.tipo:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
        </Style>
        <Style Selector="ToggleButton.tipo:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoHoverBrush}"/>
        </Style>
        <Style Selector="ToggleButton.tipo:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoPressedBrush}"/>
        </Style>

        <!--
          Stile per i bottoni "danger" (azioni distruttive: Elimina sospeso).
          Variante rossa con stesso comportamento sui quattro stati.
        -->
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B85450"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#B85450"/>
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A04340"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#A04340"/>
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#8C3B38"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#8C3B38"/>
        </Style>
        <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D6D6D6"/>
            <Setter Property="Foreground" Value="#7A7A7A"/>
            <Setter Property="BorderBrush" Value="#D6D6D6"/>
        </Style>

        <!--
          Step 8: indicatore visivo unificato per il focus da tastiera.
          In Avalonia 12 il FocusAdorner viene mostrato SOLO quando il focus
          arriva da tastiera (Tab/frecce), non da click del mouse. Definendolo
          a livello globale otteniamo il bordo giallo 3px ovunque senza codice
          aggiuntivo nelle view. Stesso colore del highlight dello step 7.
        -->
        <Style Selector="Button">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="#FFD500" BorderThickness="3" CornerRadius="0"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="#FFD500" BorderThickness="3" CornerRadius="0"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="#FFD500" BorderThickness="3" CornerRadius="0"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <!--
          Step 8: i TabItem (header Home/Cronologia/Sospesi) NON entrano nel Tab
          order: Ctrl+Tab e' la scorciatoia per cambiare tab, il Tab semplice
          deve restare dentro il contenuto della tab corrente (altrimenti dopo
          aver ciclato fra le 4 zone della Home il focus 'scappava' sull'header
          della tab successiva e le frecce su/giu' smettevano di funzionare).
        -->
        <Style Selector="TabItem">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="#FFD500" BorderThickness="3" CornerRadius="0"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="#FFD500" BorderThickness="3" CornerRadius="0"/>
                </FocusAdornerTemplate>
            </Setter>
        </Style>

        <!-- M3 touch: target tap minimi. Su desktop SzTapMin=32 (≈ come oggi),
             su Android 48. MinHeight non altera i bottoni desktop (gia' ~32). -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="{DynamicResource SzTapMin}"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="{DynamicResource SzTapMin}"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="{DynamicResource SzTapMin}"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="MinHeight" Value="{DynamicResource SzTapMin}"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="MinHeight" Value="{DynamicResource SzTapMin}"/>
        </Style>
    </Application.Styles>

</Application>
