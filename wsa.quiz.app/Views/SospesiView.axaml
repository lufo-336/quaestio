<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.SospesiView"
             x:DataType="views:SospesiView">

    <DockPanel>

        <!-- ======================================== HEADER -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="20,16,20,8">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static r:Strings.Sospesi_Titolo}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Sottotitolo}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{x:Static r:Strings.Comune_Aggiorna}"
                    Click="OnAggiornaClick"
                    Padding="14,6"
                    FontSize="12"
                    ToolTip.Tip="{x:Static r:Strings.Sospesi_AggiornaTip}"/>
        </Grid>

        <!-- ======================================== STATO VUOTO -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding NessunaSessione}"
                Margin="20,8,20,0"
                Background="{DynamicResource SystemRegionBrush}"
                BorderBrush="{DynamicResource SystemBaseLowColor}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="20">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{x:Static r:Strings.Sospesi_Nessuna}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static r:Strings.Sospesi_NessunaDettaglio}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="520"/>
            </StackPanel>
        </Border>

        <!-- ======================================== LISTA -->
        <ScrollViewer Margin="20,8,20,16"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding !NessunaSessione}">
            <ListBox x:Name="ListaPause"
                     ItemsSource="{Binding Sessioni}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="state:SessioneSospesaItem">
                        <Border Background="{DynamicResource SystemRegionBrush}"
                                BorderBrush="{DynamicResource SystemBaseLowColor}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">

                                <!-- Riga 1: data + tipo -->
                                <Grid Grid.Column="0" Grid.Row="0"
                                      ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding DataFormattata}"
                                               FontWeight="SemiBold"
                                               FontSize="13"/>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SystemBaseLowColor}"
                                            CornerRadius="3"
                                            Padding="6,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding TipoEtichetta}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SystemBaseMediumHighColor}"/>
                                    </Border>
                                </Grid>

                                <!-- Riga 2: modalita' + materia. Grid (non StackPanel
                                     orizzontale) così la materia in colonna * resta
                                     vincolata alla larghezza disponibile e viene troncata
                                     con ellissi invece di sovrapporsi ai bottoni Riprendi/
                                     Elimina della colonna a fianco. Margine destro per
                                     staccarla dai bottoni. -->
                                <Grid Grid.Column="0" Grid.Row="1"
                                      ColumnDefinitions="Auto,Auto,*"
                                      Margin="0,4,8,0">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Modalita}"
                                               FontSize="12"/>
                                    <TextBlock Grid.Column="1"
                                               Text="·"
                                               FontSize="12"
                                               Margin="8,0"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MateriaEtichetta}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </Grid>

                                <!-- Riga 3: avanzamento + tempo -->
                                <StackPanel Grid.Column="0" Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,4,0,0"
                                            Spacing="16">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Static r:Strings.Sospesi_Progresso}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                        <TextBlock Text="{Binding Avanzamento}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Static r:Strings.Sospesi_Tempo}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                        <TextBlock Text="{Binding TempoTrascorsoFormattato}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Bottoni: stato normale.
                                     IsTabStop=False per le stesse ragioni della Cronologia:
                                     Tab atterra sul ListBoxItem (= riga), non sui bottoni
                                     interni. Riprendi/Elimina da tastiera: Invio = Riprendi,
                                     Canc = elimina. -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding NonInAttesaConferma}">
                                    <Button Content="{x:Static r:Strings.Sospesi_Riprendi}"
                                            Classes="accent"
                                            Click="OnRiprendiClick"
                                            IsTabStop="False"
                                            Padding="{DynamicResource SzBtnPadding}"
                                            FontSize="12"/>
                                    <Button Content="{x:Static r:Strings.Comune_Elimina}"
                                            Click="OnEliminaClick"
                                            IsTabStop="False"
                                            Classes="danger"
                                            Padding="{DynamicResource SzBtnPadding}"
                                            FontSize="12"/>
                                </StackPanel>

                                <!-- Bottoni: stato conferma -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                            Orientation="Horizontal"
                                            Spacing="6"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding InAttesaConfermaEliminazione}">
                                    <TextBlock Text="{x:Static r:Strings.Comune_Sicuro}"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#B85450"
                                               FontWeight="SemiBold"
                                               Margin="0,0,4,0"/>
                                    <Button Content="{x:Static r:Strings.Comune_SiElimina}"
                                            Click="OnConfermaEliminaClick"
                                            IsTabStop="False"
                                            Classes="danger"
                                            Padding="{DynamicResource SzBtnPadding}"
                                            FontSize="12"/>
                                    <Button Content="{x:Static r:Strings.Comune_Annulla}"
                                            Click="OnAnnullaEliminaClick"
                                            IsTabStop="False"
                                            Padding="{DynamicResource SzBtnPadding}"
                                            FontSize="12"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </DockPanel>

</UserControl>
