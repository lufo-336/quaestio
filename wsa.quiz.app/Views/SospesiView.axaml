<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.SospesiView"
             x:DataType="views:SospesiView">

    <UserControl.Styles>
        <!-- Niente padding extra di Fluent sui ListBoxItem: le righe si allineano
             ai margini orizzontali della schermata (20px) come le altre viste. -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style Selector="Button.segmento">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SfondoRialzato}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaForte}"/>
        </Style>
        <Style Selector="Button.segmento /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SfondoRialzato}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaForte}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TestoPrincipale}"/>
        </Style>
        <Style Selector="Button.segmento:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sfondo}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaForte}"/>
        </Style>
        <Style Selector="Button.segmento.attivo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
        </Style>
        <Style Selector="Button.segmento.attivo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
        </Style>
        <Style Selector="Button.segmento.attivo:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
        </Style>
        <Style Selector="Button.segmento:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sfondo}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaDebole}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TestoAttenuato}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- ======================================== HEADER -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="20,16,20,8">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static r:Strings.Sospesi_Titolo}"
                           FontFamily="{DynamicResource FontTitoli}"
                           FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding Sottotitolo}"
                           FontSize="12"
                           Foreground="{DynamicResource TestoAttenuato}"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="{x:Static r:Strings.Comune_Aggiorna}"
                    Click="OnAggiornaClick"
                    Padding="14,6"
                    FontSize="12"
                    ToolTip.Tip="{x:Static r:Strings.Sospesi_AggiornaTip}"/>
        </Grid>

        <!-- Interruttore globale Quiz | Laboratorio -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,6,*"
              Margin="20,0,20,8">
            <Button Grid.Column="0"
                    Classes="segmento"
                    Classes.attivo="{Binding !Laboratorio}"
                    Content="{x:Static r:Strings.Lab_ModoQuiz}"
                    Click="OnModoQuizClick"/>
            <Button Grid.Column="2"
                    Classes="segmento"
                    Classes.attivo="{Binding Laboratorio}"
                    Content="{x:Static r:Strings.Lab_ModoLaboratorio}"
                    Click="OnModoLabClick"/>
        </Grid>

        <!-- ======================================== STATO VUOTO -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding NessunaSessione}"
                Margin="20,8,20,0"
                Background="Transparent"
                BorderBrush="{DynamicResource RigaDebole}"
                BorderThickness="0,1,0,1"
                Padding="0,20">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{x:Static r:Strings.Sospesi_Nessuna}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{x:Static r:Strings.Sospesi_NessunaDettaglio}"
                           FontSize="12"
                           Foreground="{DynamicResource TestoAttenuato}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="520"/>
            </StackPanel>
        </Border>

        <!-- ======================================== LISTA -->
        <ScrollViewer Margin="20,8,20,16"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding !NessunaSessione}">
            <ListBox x:Name="ListaPause"
                     Margin="{DynamicResource SzRiservaNav}"
                     ItemsSource="{Binding Sessioni}"
                     SelectionMode="Single"
                     Background="Transparent"
                     Padding="0"
                     BorderBrush="{DynamicResource RigaDebole}"
                     BorderThickness="0,0,0,1">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="state:SessioneSospesaItem">
                        <Border Background="Transparent"
                                BorderBrush="{DynamicResource RigaDebole}"
                                BorderThickness="0,1,0,0"
                                Padding="0,14">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                  Initialized="OnRigaSospesaInitialized">

                                <!-- Riga 1: data + tipo -->
                                <Grid Grid.Column="0" Grid.Row="0"
                                      ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding DataFormattata}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource RigaDebole}"
                                            Padding="6,2"
                                            Margin="8,0,0,0">
                                        <TextBlock Text="{Binding TipoEtichetta}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TestoPrincipale}"/>
                                    </Border>
                                </Grid>

                                <!-- Riga 2: modalita' + materia (wrappa su schermo stretto senza sovrapporsi) -->
                                <TextBlock Grid.Column="0" Grid.Row="1"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Margin="0,4,0,0">
                                    <Run Text="{Binding Modalita}" FontWeight="SemiBold"/>
                                    <Run Text=" · " FontSize="12" Foreground="{DynamicResource TestoAttenuato}"/>
                                    <Run Text="{Binding MateriaEtichetta}" FontSize="12" Foreground="{DynamicResource TestoAttenuato}"/>
                                </TextBlock>

                                <!-- Riga 3: avanzamento + tempo -->
                                <WrapPanel Grid.Column="0" Grid.Row="2"
                                           Orientation="Horizontal"
                                           ItemSpacing="14"
                                           LineSpacing="4"
                                           Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Static r:Strings.Sospesi_Progresso}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TestoAttenuato}"/>
                                        <TextBlock Text="{Binding Avanzamento}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Static r:Strings.Sospesi_Tempo}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TestoAttenuato}"/>
                                        <TextBlock Text="{Binding TempoTrascorsoFormattato}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Azioni: a destra su desktop, spostate alla riga 3 (sotto) in TouchMode.
                                     IsTabStop=False per le stesse ragioni della Cronologia:
                                     Tab atterra sul ListBoxItem (= riga), non sui bottoni
                                     interni. Riprendi/Elimina da tastiera: Invio = Riprendi,
                                     Canc = elimina. -->
                                <Panel Tag="Azioni"
                                       Grid.Column="1" Grid.Row="0" Grid.RowSpan="3"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                IsVisible="{Binding NonInAttesaConferma}">
                                        <Button Content="{x:Static r:Strings.Sospesi_Riprendi}"
                                                Classes="accent"
                                                Click="OnRiprendiClick"
                                                IsTabStop="False"
                                                Padding="{DynamicResource SzBtnPadding}"
                                                FontSize="12"/>
                                        <Button Content="{x:Static r:Strings.Comune_Elimina}"
                                                Click="OnEliminaClick"
                                                IsTabStop="False"
                                                Classes="danger"
                                                Padding="{DynamicResource SzBtnPadding}"
                                                FontSize="12"/>
                                    </StackPanel>

                                    <WrapPanel Orientation="Horizontal"
                                               ItemSpacing="6"
                                               LineSpacing="6"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding InAttesaConfermaEliminazione}">
                                        <TextBlock Text="{x:Static r:Strings.Comune_Sicuro}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource RossoTestoBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,4,0"/>
                                        <Button Content="{x:Static r:Strings.Comune_SiElimina}"
                                                Click="OnConfermaEliminaClick"
                                                IsTabStop="False"
                                                Classes="danger"
                                                Padding="{DynamicResource SzBtnPadding}"
                                                FontSize="12"/>
                                        <Button Content="{x:Static r:Strings.Comune_Annulla}"
                                                Click="OnAnnullaEliminaClick"
                                                IsTabStop="False"
                                                Padding="{DynamicResource SzBtnPadding}"
                                                FontSize="12"/>
                                    </WrapPanel>
                                </Panel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </DockPanel>

</UserControl>
