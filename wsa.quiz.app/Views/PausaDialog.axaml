<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             x:Class="Wsa.Quiz.App.Views.PausaDialog">

  <UserControl.Styles>
    <!-- Accent dinamico: usa i brush dell'applicazione (vedi App.axaml). -->
    <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentoBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentoHoverBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentoHoverBrush}"/>
    </Style>
  </UserControl.Styles>

  <!-- Card del dialogo (overlay in-page). Token di tema per chiaro/scuro. -->
  <Border x:Name="CardBorder"
          Background="{DynamicResource SfondoRialzato}"
          BorderBrush="{DynamicResource RigaDebole}"
          BorderThickness="1"
          Padding="20"
          Margin="16,0"
          MinWidth="280"
          MaxWidth="480">
    <StackPanel Spacing="12">
      <TextBlock x:Name="TitoloText"
                 Text="{x:Static r:Strings.Pausa_Titolo}"
                 FontSize="14"
                 FontWeight="SemiBold"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TestoPrincipale}"/>
      <TextBlock x:Name="SpiegazioneText"
                 Text="{x:Static r:Strings.Pausa_Spiegazione}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TestoAttenuato}"/>

      <!-- Pulsantiera: tre pulsanti a tutta larghezza in colonna (stessa cosa su ogni larghezza) -->
      <StackPanel x:Name="Pulsantiera" Spacing="8" Margin="0,4,0,0">
        <Button x:Name="SalvaBtn"
                Content="{x:Static r:Strings.Pausa_SalvaEsci}"
                Padding="14,8"
                Classes="accent"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnSalvaClick"/>
        <Button x:Name="AnnullaBtn"
                Content="{x:Static r:Strings.Comune_Annulla}"
                Padding="14,8"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnAnnullaClick"/>
        <Button x:Name="AbbandonaBtn"
                Content="{x:Static r:Strings.Pausa_Abbandona}"
                Padding="14,8"
                Classes="danger"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="OnAbbandonaClick"/>
      </StackPanel>
    </StackPanel>
  </Border>

</UserControl>
