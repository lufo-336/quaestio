<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stats="using:Wsa.Quiz.Core.Models.Statistiche"
             xmlns:views="using:Wsa.Quiz.App.Views"
             xmlns:c="using:Wsa.Quiz.App.Controls"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.CategoriaDettaglioView"
             x:DataType="views:CategoriaDettaglioView">

    <DockPanel>

        <!-- Header con bottone indietro + titolo -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="Auto,*"
              Margin="20,16,20,8">
            <Button Content="{x:Static r:Strings.Statistiche_Indietro}"
                    Click="OnIndietroClick"
                    Padding="14,6"
                    FontSize="12"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding Titolo}"
                       FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- Lista domande sbagliate -->
        <ScrollViewer Margin="20,0,20,16"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sbagliate}" Margin="{DynamicResource SzRiservaNav}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="stats:DomandaSbagliata">
                        <Border BorderBrush="#B85450"
                                Background="#F9E7E6"
                                BorderThickness="1"
                                CornerRadius="2"
                                Padding="10"
                                Margin="0,4">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="#B85450"
                                           FontSize="12">
                                    <Run Text="{x:Static r:Strings.Statistiche_SbagliataPrefisso}"/>
                                    <Run Text="{Binding VolteSbagliata}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding VolteVista}"/>
                                    <Run Text="{x:Static r:Strings.Statistiche_VolteSuffisso}"/>
                                </TextBlock>
                                <c:TestoConCodice Testo="{Binding Testo}"
                                           Foreground="#1F1F1F"/>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="{x:Static r:Strings.Statistiche_CorrettaPrefisso}"
                                               Foreground="#1F7A4D"
                                               FontSize="12"/>
                                    <c:TestoConCodice Grid.Column="1"
                                               Testo="{Binding RispostaCorretta}"
                                               Foreground="#1F7A4D"
                                               FontSize="12"/>
                                </Grid>
                                <c:TestoConCodice Testo="{Binding Spiegazione}"
                                           FontStyle="Italic"
                                           FontSize="12"
                                           Foreground="#5A5A5A"
                                           IsVisible="{Binding Spiegazione, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
