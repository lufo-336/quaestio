<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:c="using:Wsa.Quiz.App.Controls"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.CronologiaDettaglioView"
             Padding="{DynamicResource SzRiservaNav}"
             x:DataType="views:CronologiaDettaglioView">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">

        <!-- TOP BAR (indietro + titolo) -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
            <Button Content="{x:Static r:Strings.Dettaglio_IndietroCronologia}"
                    Click="OnIndietroClick"
                    Padding="12,6"
                    FontSize="12"
                    ToolTip.Tip="{x:Static r:Strings.Dettaglio_IndietroTip}"/>
            <StackPanel Grid.Column="1" Spacing="2" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Titolo}"
                           FontFamily="{DynamicResource FontTitoli}"
                           FontSize="20" FontWeight="ExtraBold"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Sottotitolo}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TestoAttenuato}"/>
            </StackPanel>
        </Grid>

        <!-- STATISTICHE (stesso pattern di RiepilogoView) -->
        <Border Grid.Row="1"
                Background="{DynamicResource SfondoRialzato}"
                BorderBrush="{DynamicResource RigaDebole}"
                BorderThickness="1"
                Padding="20"
                Margin="0,0,0,12">
            <Grid x:Name="GrigliaStat" ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto">
                <StackPanel x:Name="BloccoPercentuale"
                            Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding PercentualeFormattata}"
                               FontSize="34" FontWeight="Bold"
                               Foreground="{Binding ColorePercentuale}"/>
                    <TextBlock Text="{x:Static r:Strings.Riepilogo_CorretteMinuscolo}"
                               FontSize="11"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                </StackPanel>

                <StackPanel x:Name="BloccoTotale" Grid.Column="1" Grid.Row="0" Spacing="2">
                    <TextBlock Text="{x:Static r:Strings.Riepilogo_Totale}"
                               FontSize="11"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                    <TextBlock Text="{Binding TotaleDomande}"
                               FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel x:Name="BloccoCorrette" Grid.Column="2" Grid.Row="0" Spacing="2">
                    <TextBlock Text="{x:Static r:Strings.Riepilogo_Corrette}"
                               FontSize="11"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                    <TextBlock Text="{Binding RisposteCorrette}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource VerdeTestoBrush}"/>
                </StackPanel>
                <StackPanel x:Name="BloccoErrate" Grid.Column="3" Grid.Row="0" Spacing="2">
                    <TextBlock Text="{x:Static r:Strings.Riepilogo_Errate}"
                               FontSize="11"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                    <TextBlock Text="{Binding RisposteErrate}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource RossoTestoBrush}"/>
                </StackPanel>
                <StackPanel x:Name="BloccoPunteggio" Grid.Column="4" Grid.Row="0" Spacing="2">
                    <TextBlock Text="{x:Static r:Strings.Riepilogo_Punteggio}"
                               FontSize="11"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                    <TextBlock Text="{Binding Punteggio}"
                               FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel x:Name="BloccoDurataModalita"
                           Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4"
                           Spacing="4" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static r:Strings.Riepilogo_Durata}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                        <TextBlock Text="{Binding DurataFormattata}"
                                   FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <!-- Etichetta e valore in un solo TextBlock: dentro uno StackPanel orizzontale il testo non andrebbe a capo. -->
                    <TextBlock FontSize="12" TextWrapping="Wrap">
                        <Run Text="{x:Static r:Strings.Riepilogo_Modalita}" Foreground="{DynamicResource TestoAttenuato}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Modalita}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <!-- Etichetta e valore in un solo TextBlock: dentro uno StackPanel orizzontale il testo non andrebbe a capo. -->
                    <TextBlock FontSize="12" TextWrapping="Wrap">
                        <Run Text="{x:Static r:Strings.Dettaglio_Materia}" Foreground="{DynamicResource TestoAttenuato}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding MateriaEtichetta}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LISTA DETTAGLI (stesso template di RiepilogoView, ma con colore dal flag Corretta) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding TitoloLista}"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <TextBlock Text="{x:Static r:Strings.Dettaglio_NessunaRisposta}"
                           IsVisible="{Binding NessunDettaglio}"
                           Foreground="{DynamicResource TestoAttenuato}"
                           FontStyle="Italic"/>

                <ItemsControl ItemsSource="{Binding Dettagli}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="state:DettaglioRispostaItem">
                            <Border Background="{DynamicResource SfondoRialzato}"
                                    BorderBrush="{Binding ColoreBordo}"
                                    BorderThickness="2"
                                    Padding="14,10"
                                    Margin="0,0,0,6">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TestoAttenuato}">
                                            <Run Text="{Binding MateriaNome}"/>
                                            <Run Text="·"/>
                                            <Run Text="{Binding Categoria}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding EsitoEtichetta}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="8,0,0,0"
                                                   Foreground="{Binding ColoreEsito}"/>
                                    </Grid>

                                    <c:TestoConCodice Testo="{Binding TestoDomanda}"
                                               FontWeight="SemiBold"/>

                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Static r:Strings.Comune_TuHaiRisposto}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TestoAttenuato}"
                                                   Margin="0,0,8,0"/>
                                        <c:TestoConCodice Grid.Column="1"
                                                   Testo="{Binding RispostaData}"
                                                   FontSize="12"
                                                   Foreground="{Binding ColoreRisposta}"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*"
                                          IsVisible="{Binding MostraRispostaCorretta}">
                                        <TextBlock Text="{x:Static r:Strings.Comune_CorrettaDuePunti}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TestoAttenuato}"
                                                   Margin="0,0,8,0"/>
                                        <c:TestoConCodice Grid.Column="1"
                                                   Testo="{Binding RispostaCorretta}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource VerdeTestoBrush}"/>
                                    </Grid>

                                    <TextBlock Text="{Binding TentativiEtichetta}"
                                               IsVisible="{Binding MostraTentativi}"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TestoAttenuato}"/>

                                    <TextBlock Text="{Binding SecondoTentativoEtichetta}"
                                               IsVisible="{Binding MostraSecondoTentativo}"
                                               FontSize="11"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TestoAttenuato}"/>

                                    <c:TestoConCodice Testo="{Binding Spiegazione}"
                                               FontSize="11"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding Spiegazione, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{DynamicResource TestoPrincipale}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- BARRA IN BASSO -->
        <Grid x:Name="BarraInferiore"
              Grid.Row="3"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              Margin="0,16,0,0">

            <!-- Stato normale -->
            <Button Grid.Column="0"
                    Grid.Row="0"
                    HorizontalAlignment="Left"
                    Content="{x:Static r:Strings.Dettaglio_EliminaPartita}"
                    Click="OnEliminaClick"
                    Classes="danger"
                    Padding="14,8"
                    FontSize="12"
                    IsVisible="{Binding NonInAttesaConferma}"/>

            <!-- Stato conferma -->
            <WrapPanel Grid.Column="0"
                       Grid.Row="0"
                       Orientation="Horizontal"
                       ItemSpacing="6"
                       LineSpacing="6"
                       VerticalAlignment="Center"
                       IsVisible="{Binding InAttesaConfermaEliminazione}">
                <TextBlock Text="{x:Static r:Strings.Comune_Sicuro}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource RossoTestoBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,4,0"/>
                <Button Content="{x:Static r:Strings.Comune_SiElimina}"
                        Click="OnConfermaEliminaClick"
                        Classes="danger"
                        Padding="14,6"
                        FontSize="12"/>
                <Button Content="{x:Static r:Strings.Comune_Annulla}"
                        Click="OnAnnullaEliminaClick"
                        Padding="14,6"
                        FontSize="12"/>
            </WrapPanel>

            <Button x:Name="TornaBtn"
                    Grid.Column="1"
                    Grid.Row="0"
                    Content="{x:Static r:Strings.Dettaglio_TornaCronologia}"
                    Click="OnIndietroClick"
                    Classes="accent"
                    Padding="22,10"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="12,0,0,0"/>
        </Grid>

    </Grid>

</UserControl>
