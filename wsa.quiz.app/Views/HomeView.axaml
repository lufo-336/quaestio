<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.HomeView"
             x:DataType="views:HomeView">

    <UserControl.Styles>
        <Style Selector="Button.segmento">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SfondoRialzato}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaForte}"/>
        </Style>
        <Style Selector="Button.segmento /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SfondoRialzato}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaForte}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TestoPrincipale}"/>
        </Style>
        <Style Selector="Button.segmento:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sfondo}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaForte}"/>
        </Style>
        <Style Selector="Button.segmento.attivo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
        </Style>
        <Style Selector="Button.segmento.attivo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
        </Style>
        <Style Selector="Button.segmento.attivo:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentoTestoBrush}"/>
        </Style>
        <Style Selector="Button.segmento:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sfondo}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RigaDebole}"/>
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TestoAttenuato}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
    </UserControl.Styles>

    <!-- Step 8: Tab cicla DENTRO la Home (le 4 zone) e non scappa fuori, cosi'
         dopo l'ultima zona si ritorna alla prima invece di perdere il focus. -->
    <DockPanel KeyboardNavigation.TabNavigation="Cycle">

        <!-- ============================== AVVIO (sticky in alto) ============================== -->
        <Border x:Name="ZonaAvvia"
                KeyboardNavigation.TabNavigation="Once"
                DockPanel.Dock="Top"
                Background="{DynamicResource SfondoRialzato}"
                BorderBrush="{DynamicResource RigaDebole}"
                BorderThickness="0,0,0,1"
                Padding="20,12,20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding RiepilogoSelezione}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AvvisoSelezione}"
                               Foreground="{DynamicResource RossoTestoBrush}"
                               IsVisible="{Binding HaAvviso}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="AvviaBtn"
                        Grid.Column="1"
                        Content="{Binding EtichettaAvvia}"
                        Click="OnAvviaClick"
                        IsEnabled="{Binding PuoAvviare}"
                        Classes="accent"
                        Padding="22,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================== CONTENUTO SCROLLABILE ============================== -->
        <!-- Padding da risorsa: desktop 20 (identico a prima), touch 12 (più denso). -->
        <!-- Il margine pagina sta su un Border DENTRO lo scroll: il Padding del
             ScrollViewer non entra nell'altezza scorrevole e il fondo restava tagliato. -->
        <ScrollViewer>
            <Border Padding="{DynamicResource SzPaginaMargin}">
            <StackPanel x:Name="ContenutoScroll" Spacing="16" Margin="{DynamicResource SzRiservaNav}" MaxWidth="980" HorizontalAlignment="Stretch">

                <!-- Interruttore globale Quiz | Laboratorio -->
                <Border x:Name="ZonaModo"
                        KeyboardNavigation.TabNavigation="Once">
                    <Grid ColumnDefinitions="*,6,*">
                        <Button x:Name="ModoQuizBtn"
                                Grid.Column="0"
                                Classes="segmento"
                                Classes.attivo="{Binding !Laboratorio}"
                                Content="{x:Static r:Strings.Lab_ModoQuiz}"
                                Click="OnModoQuizClick"/>
                        <Button x:Name="ModoLabBtn"
                                Grid.Column="2"
                                Classes="segmento"
                                Classes.attivo="{Binding Laboratorio}"
                                Content="{x:Static r:Strings.Lab_ModoLaboratorio}"
                                Click="OnModoLabClick"/>
                    </Grid>
                </Border>

                <!-- ============================== LABORATORIO ============================== -->
                <StackPanel x:Name="ZonaLaboratorio"
                            IsVisible="{Binding Laboratorio}"
                            Spacing="16">

                    <!-- Linguaggio -->
                    <Border x:Name="ZonaLabLinguaggio"
                            KeyboardNavigation.TabNavigation="Once"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14">
                        <StackPanel Spacing="8">
                            <Border Classes="trattino">
                                <TextBlock Text="{x:Static r:Strings.Lab_Linguaggio}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{x:Static r:Strings.Lab_AvvisoNessunaScheda}"
                                       Foreground="{DynamicResource TestoAttenuato}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding NessunLinguaggioLab}"/>
                            <ItemsControl ItemsSource="{Binding LinguaggiLab}"
                                          IsVisible="{Binding !NessunLinguaggioLab}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="state:LinguaggioLabItem">
                                        <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     Click="OnLinguaggioLabClick"
                                                     Margin="0,2">
                                            <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Livello -->
                    <Border x:Name="ZonaLabLivello"
                            KeyboardNavigation.TabNavigation="Once"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14">
                        <StackPanel Spacing="10">
                            <Border Classes="trattino">
                                <TextBlock Text="{x:Static r:Strings.Lab_Livello}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Grid ColumnDefinitions="*,6,*,6,*">
                                <Button Grid.Column="0"
                                        Classes="segmento"
                                        Classes.attivo="{Binding IsLabBase}"
                                        IsEnabled="{Binding HaSchedeBase}"
                                        Content="{Binding EtichettaLabBase}"
                                        Tag="base"
                                        Click="OnLabLivelloClick"/>
                                <Button Grid.Column="2"
                                        Classes="segmento"
                                        Classes.attivo="{Binding IsLabMedia}"
                                        IsEnabled="{Binding HaSchedeMedia}"
                                        Content="{Binding EtichettaLabMedia}"
                                        Tag="media"
                                        Click="OnLabLivelloClick"/>
                                <Button Grid.Column="4"
                                        Classes="segmento"
                                        Classes.attivo="{Binding IsLabAlta}"
                                        IsEnabled="{Binding HaSchedeAlta}"
                                        Content="{Binding EtichettaLabAlta}"
                                        Tag="alta"
                                        Click="OnLabLivelloClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Schede -->
                    <Border x:Name="ZonaLabSchede"
                            KeyboardNavigation.TabNavigation="Once"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14">
                        <StackPanel Spacing="8">
                            <Border Classes="trattino">
                                <TextBlock Text="{x:Static r:Strings.Lab_Schede}"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <!-- Niente GroupName: vedi Trappola 19. -->
                            <RadioButton IsChecked="{Binding LabSoloNonViste, Mode=TwoWay}">
                                <TextBlock Text="{x:Static r:Strings.Lab_SoloNonViste}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <RadioButton IsChecked="{Binding LabRipassa, Mode=TwoWay}">
                                <TextBlock Text="{x:Static r:Strings.Lab_RipassaSbagliate}" TextWrapping="Wrap"/>
                            </RadioButton>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" Margin="0,4,0,0">
                                <NumericUpDown Minimum="1" Maximum="50"
                                               Value="{Binding LabSchede, Mode=TwoWay}"
                                               Increment="1"
                                               FormatString="0"
                                               Width="120"
                                               VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static r:Strings.Lab_SchedePerSessione}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Materie + Categorie -->
                <Grid x:Name="GrigliaMaterieCategorie" IsVisible="{Binding !Laboratorio}" ColumnDefinitions="*,16,2*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">

                    <!-- ============================== MATERIE ============================== -->
                    <Border x:Name="ZonaMaterie"
                            KeyboardNavigation.TabNavigation="Once"
                            Grid.Row="0" Grid.Column="0"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14">
                        <DockPanel>
                            <Border Classes="trattino" DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock
                                       Text="{x:Static r:Strings.Home_Materie}"
                                       FontWeight="SemiBold"/>
                            </Border>
                            <ScrollViewer MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Materie}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="state:MateriaSelezionabile">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,3">
                                                <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ============================== CATEGORIE ============================== -->
                    <Border x:Name="ZonaCategorie"
                            KeyboardNavigation.TabNavigation="Once"
                            Grid.Row="0" Grid.Column="2"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14"
                            MinHeight="180">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <Border Classes="trattino" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static r:Strings.Home_CategorieTitolo}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                </Border>
                                <Button Grid.Column="1"
                                        Content="{x:Static r:Strings.Home_Pulisci}"
                                        Click="OnPulisciCategorieClick"
                                        Padding="10,3"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        IsEnabled="{Binding HaCategorieSelezionate}"/>
                            </Grid>

                            <TextBlock x:Name="EmptyCategorieText"
                                       Text="{x:Static r:Strings.Home_SelezionaMateriaPerCategorie}"
                                       Foreground="{DynamicResource TestoAttenuato}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding NessunaCategoriaDisponibile}"/>

                            <ScrollViewer MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding !NessunaCategoriaDisponibile}">
                                <ItemsControl ItemsSource="{Binding CategorieVisibili}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="state:CategoriaSelezionabile">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MateriaEtichetta}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TestoAttenuato}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ============================== OPZIONI ============================== -->
                <Border x:Name="ZonaOpzioni"
                        IsVisible="{Binding !Laboratorio}"
                        KeyboardNavigation.TabNavigation="Once"
                        Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <Border Classes="trattino">
                            <TextBlock Text="{x:Static r:Strings.Home_Opzioni}"
                                   FontWeight="SemiBold"/>
                        </Border>

                        <CheckBox IsChecked="{Binding RandomizzaOrdine, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static r:Strings.Home_RandomizzaTip}">
                            <TextBlock Text="{x:Static r:Strings.Home_Randomizza}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Rotazione, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static r:Strings.Home_RotazioneTip}">
                            <TextBlock Text="{x:Static r:Strings.Home_Rotazione}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding SecondaPossibilita, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static r:Strings.Home_SecondaPossibilitaTip}">
                            <TextBlock Text="{x:Static r:Strings.Home_SecondaPossibilita}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Cronometro, Mode=TwoWay}">
                            <TextBlock Text="{x:Static r:Strings.Home_MostraCronometro}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" Margin="0,4,0,0">
                            <CheckBox Content="{x:Static r:Strings.Home_LimitaA}"
                                      IsChecked="{Binding LimitaDomande, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                            <NumericUpDown Minimum="1" Maximum="9999"
                                           Value="{Binding LimiteN, Mode=TwoWay}"
                                           Increment="5"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding LimitaDomande}"/>
                            <TextBlock Text="{x:Static r:Strings.Home_DomandeEstratte}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" Margin="0,4,0,0">
                            <CheckBox Content="{x:Static r:Strings.Home_ModalitaTempo}"
                                      IsChecked="{Binding ModalitaTempo, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{x:Static r:Strings.Home_ModalitaTempoTip}"/>
                            <NumericUpDown Minimum="1" Maximum="180"
                                           Value="{Binding MinutiTempo, Mode=TwoWay}"
                                           Increment="5"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding ModalitaTempo}"/>
                            <TextBlock Text="{x:Static r:Strings.Comune_Minuti}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============================== TIPO DI DOMANDE ============================== -->
                <!-- Tre pulsanti filtro (variante B del mockup del 14/11):
                     si sommano a materie e categorie. Nessuno acceso = tutti inclusi. -->
                <Border x:Name="ZonaTipo"
                        IsVisible="{Binding !Laboratorio}"
                        KeyboardNavigation.TabNavigation="Once"
                        Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <Border Classes="trattino">
                            <TextBlock Text="{x:Static r:Strings.Home_TipoTitolo}"
                                   FontWeight="SemiBold"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Tipi}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Initialized="OnGrigliaFiltriInitialized"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="state:TipoSelezionabile">
                                    <ToggleButton Classes="tipo"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="6,8"
                                                  Margin="0,0,6,0"
                                                  Initialized="OnFiltroToggleInitialized">
                                        <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static r:Strings.Home_TipoSuggerimento}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                    </StackPanel>
                </Border>

                <!-- ============================== PUNTI DEBOLI ============================== -->
                <!-- Quattro pulsanti filtro (Rosse / Ambra / Verdi / Nuove):
                     filtrano le categorie in base allo storico. Nessuno acceso = nessun filtro. -->
                <Border x:Name="ZonaLivelli"
                        IsVisible="{Binding !Laboratorio}"
                        KeyboardNavigation.TabNavigation="Once"
                        Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <Border Classes="trattino">
                            <TextBlock Text="{x:Static r:Strings.Home_PuntiDeboliTitolo}"
                                   FontWeight="SemiBold"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Livelli}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Initialized="OnGrigliaFiltriInitialized"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="state:LivelloSelezionabile">
                                    <ToggleButton Classes="tipo"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="6,8"
                                                  Margin="0,0,6,0"
                                                  Initialized="OnFiltroToggleInitialized">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding ColorePallino}"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Etichetta}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static r:Strings.Home_PuntiDeboliSuggerimento}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>

</UserControl>
