<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.HomeView"
             x:DataType="views:HomeView">

    <!-- Step 8: Tab cicla DENTRO la Home (le 4 zone) e non scappa fuori, cosi'
         dopo l'ultima zona si ritorna alla prima invece di perdere il focus. -->
    <DockPanel KeyboardNavigation.TabNavigation="Cycle">

        <!-- ============================== AVVIO (sticky in alto) ============================== -->
        <Border x:Name="ZonaAvvia"
                KeyboardNavigation.TabNavigation="Once"
                DockPanel.Dock="Top"
                Background="{DynamicResource SfondoRialzato}"
                BorderBrush="{DynamicResource RigaDebole}"
                BorderThickness="0,0,0,1"
                Padding="20,12,20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding RiepilogoSelezione}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding AvvisoSelezione}"
                               Foreground="{DynamicResource RossoTestoBrush}"
                               IsVisible="{Binding HaAvviso}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="AvviaBtn"
                        Grid.Column="1"
                        Content="{x:Static r:Strings.Home_AvviaQuiz}"
                        Click="OnAvviaClick"
                        IsEnabled="{Binding PuoAvviare}"
                        Classes="accent"
                        Padding="22,10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================== CONTENUTO SCROLLABILE ============================== -->
        <!-- Padding da risorsa: desktop 20 (identico a prima), touch 12 (più denso). -->
        <!-- Il margine pagina sta su un Border DENTRO lo scroll: il Padding del
             ScrollViewer non entra nell'altezza scorrevole e il fondo restava tagliato. -->
        <ScrollViewer>
            <Border Padding="{DynamicResource SzPaginaMargin}">
            <StackPanel x:Name="ContenutoScroll" Spacing="16" Margin="{DynamicResource SzRiservaNav}" MaxWidth="980" HorizontalAlignment="Stretch">

                <!-- Materie + Categorie -->
                <Grid x:Name="GrigliaMaterieCategorie" ColumnDefinitions="*,16,2*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">

                    <!-- ============================== MATERIE ============================== -->
                    <Border x:Name="ZonaMaterie"
                            KeyboardNavigation.TabNavigation="Once"
                            Grid.Row="0" Grid.Column="0"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{x:Static r:Strings.Home_Materie}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Materie}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="state:MateriaSelezionabile">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Margin="0,3">
                                                <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- ============================== CATEGORIE ============================== -->
                    <Border x:Name="ZonaCategorie"
                            KeyboardNavigation.TabNavigation="Once"
                            Grid.Row="0" Grid.Column="2"
                            Background="{DynamicResource SfondoRialzato}"
                            BorderBrush="{DynamicResource RigaDebole}"
                            BorderThickness="1"
                            Padding="14"
                            MinHeight="180">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="{x:Static r:Strings.Home_CategorieTitolo}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="{x:Static r:Strings.Home_Pulisci}"
                                        Click="OnPulisciCategorieClick"
                                        Padding="10,3"
                                        FontSize="11"
                                        Margin="8,0,0,0"
                                        IsEnabled="{Binding HaCategorieSelezionate}"/>
                            </Grid>

                            <TextBlock x:Name="EmptyCategorieText"
                                       Text="{x:Static r:Strings.Home_SelezionaMateriaPerCategorie}"
                                       Foreground="{DynamicResource TestoAttenuato}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding NessunaCategoriaDisponibile}"/>

                            <ScrollViewer MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding !NessunaCategoriaDisponibile}">
                                <ItemsControl ItemsSource="{Binding CategorieVisibili}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="state:CategoriaSelezionabile">
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                                </CheckBox>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding MateriaEtichetta}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TestoAttenuato}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ============================== OPZIONI ============================== -->
                <Border x:Name="ZonaOpzioni"
                        KeyboardNavigation.TabNavigation="Once"
                        Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static r:Strings.Home_Opzioni}"
                                   FontWeight="SemiBold"/>

                        <CheckBox IsChecked="{Binding RandomizzaOrdine, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static r:Strings.Home_RandomizzaTip}">
                            <TextBlock Text="{x:Static r:Strings.Home_Randomizza}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Rotazione, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static r:Strings.Home_RotazioneTip}">
                            <TextBlock Text="{x:Static r:Strings.Home_Rotazione}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding SecondaPossibilita, Mode=TwoWay}"
                                  ToolTip.Tip="{x:Static r:Strings.Home_SecondaPossibilitaTip}">
                            <TextBlock Text="{x:Static r:Strings.Home_SecondaPossibilita}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Cronometro, Mode=TwoWay}">
                            <TextBlock Text="{x:Static r:Strings.Home_MostraCronometro}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" Margin="0,4,0,0">
                            <CheckBox Content="{x:Static r:Strings.Home_LimitaA}"
                                      IsChecked="{Binding LimitaDomande, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                            <NumericUpDown Minimum="1" Maximum="9999"
                                           Value="{Binding LimiteN, Mode=TwoWay}"
                                           Increment="5"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding LimitaDomande}"/>
                            <TextBlock Text="{x:Static r:Strings.Home_DomandeEstratte}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>

                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="4" Margin="0,4,0,0">
                            <CheckBox Content="{x:Static r:Strings.Home_ModalitaTempo}"
                                      IsChecked="{Binding ModalitaTempo, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="{x:Static r:Strings.Home_ModalitaTempoTip}"/>
                            <NumericUpDown Minimum="1" Maximum="180"
                                           Value="{Binding MinutiTempo, Mode=TwoWay}"
                                           Increment="5"
                                           Width="120"
                                           VerticalAlignment="Center"
                                           IsEnabled="{Binding ModalitaTempo}"/>
                            <TextBlock Text="{x:Static r:Strings.Comune_Minuti}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ============================== TIPO DI DOMANDE ============================== -->
                <!-- Tre pulsanti filtro (variante B del mockup del 14/11):
                     si sommano a materie e categorie. Nessuno acceso = tutti inclusi. -->
                <Border x:Name="ZonaTipo"
                        KeyboardNavigation.TabNavigation="Once"
                        Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static r:Strings.Home_TipoTitolo}"
                                   FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Tipi}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Initialized="OnGrigliaFiltriInitialized"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="state:TipoSelezionabile">
                                    <ToggleButton Classes="tipo"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="6,8"
                                                  Margin="0,0,6,0"
                                                  Initialized="OnFiltroToggleInitialized">
                                        <TextBlock Text="{Binding Etichetta}" TextWrapping="Wrap"/>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static r:Strings.Home_TipoSuggerimento}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                    </StackPanel>
                </Border>

                <!-- ============================== PUNTI DEBOLI ============================== -->
                <!-- Quattro pulsanti filtro (Rosse / Ambra / Verdi / Nuove):
                     filtrano le categorie in base allo storico. Nessuno acceso = nessun filtro. -->
                <Border x:Name="ZonaLivelli"
                        KeyboardNavigation.TabNavigation="Once"
                        Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static r:Strings.Home_PuntiDeboliTitolo}"
                                   FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Livelli}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" Initialized="OnGrigliaFiltriInitialized"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="state:LivelloSelezionabile">
                                    <ToggleButton Classes="tipo"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Center"
                                                  Padding="6,8"
                                                  Margin="0,0,6,0"
                                                  Initialized="OnFiltroToggleInitialized">
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding ColorePallino}"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Etichetta}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static r:Strings.Home_PuntiDeboliSuggerimento}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>

</UserControl>
