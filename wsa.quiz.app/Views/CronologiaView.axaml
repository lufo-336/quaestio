<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.CronologiaView"
             x:DataType="views:CronologiaView">

    <DockPanel>

        <!-- ======================================== HEADER (titolo + aggiorna) -->
        <!-- I tre bottoni stanno in un WrapPanel ancorato a destra su desktop; su
             touch il code-behind lo sposta sotto il titolo, perche' su 1080px
             affiancati al titolo lo coprono (visto su device il 2026-09-09). -->
        <DockPanel DockPanel.Dock="Top"
                   Margin="20,16,20,8">
            <WrapPanel x:Name="HeaderAzioni"
                       DockPanel.Dock="Right"
                       ItemSpacing="8" LineSpacing="8"
                       VerticalAlignment="Center">

            <Button Content="{x:Static r:Strings.Comune_Aggiorna}"
                    Click="OnAggiornaClick"
                    Padding="14,6"
                    FontSize="12"
                    Margin="0,0,8,0"
                    ToolTip.Tip="{x:Static r:Strings.Cronologia_AggiornaTip}"/>

            <!-- Il formato si sceglie QUI, non nel file picker: su Linux il
                 selettore del tipo di file non compare affatto. -->
            <Button Content="{Binding EtichettaEsporta}"
                    Padding="14,6"
                    FontSize="12"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding !NessunaSessione}"
                    ToolTip.Tip="{x:Static r:Strings.Cronologia_EsportaTip}">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                        <MenuItem Header="{x:Static r:Strings.Cronologia_EsportaCsv}"
                                  Click="OnEsportaCsvClick"/>
                        <MenuItem Header="{x:Static r:Strings.Cronologia_EsportaJson}"
                                  Click="OnEsportaJsonClick"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <Button Content="{x:Static r:Strings.Cronologia_Svuota}"
                    Click="OnSvuotaCronologiaClick"
                    Classes="danger"
                    Padding="14,6"
                    FontSize="12"
                    IsEnabled="{Binding !NessunaSessione}"
                    ToolTip.Tip="{x:Static r:Strings.Cronologia_SvuotaTip}"/>

            </WrapPanel>

            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Static r:Strings.Shell_TabCronologia}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Sottotitolo}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemBaseMediumColor}"/>
            </StackPanel>

        </DockPanel>

        <!-- ======================================== LISTA + DETTAGLIO (swap) -->
        <Grid>
            <!-- LISTA -->
            <DockPanel IsVisible="{Binding !ModoDettaglio}">

                <!-- ======================================== BARRA FILTRI (step 11) -->
                <Border DockPanel.Dock="Top"
                        Margin="20,0,20,0"
                        Padding="12,8"
                        Background="{DynamicResource SystemRegionBrush}"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <WrapPanel ItemSpacing="12" LineSpacing="8">

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.Comune_Materia}" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding MaterieFiltro}"
                                      SelectedItem="{Binding FiltroMateria}"
                                      MinWidth="150"
                                      FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.Cronologia_Periodo}" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox SelectedIndex="{Binding IndicePeriodo}"
                                      MinWidth="140"
                                      FontSize="12">
                                <ComboBoxItem Content="{x:Static r:Strings.Cronologia_PeriodoTutto}"/>
                                <ComboBoxItem Content="{x:Static r:Strings.Cronologia_Ultimi7}"/>
                                <ComboBoxItem Content="{x:Static r:Strings.Cronologia_Ultimi30}"/>
                                <ComboBoxItem Content="{x:Static r:Strings.Cronologia_Personalizzato}"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                    IsVisible="{Binding MostraDatePersonalizzate}">
                            <TextBlock Text="{x:Static r:Strings.Cronologia_Dal}" VerticalAlignment="Center" FontSize="12"/>
                            <DatePicker SelectedDate="{Binding DataDa}"/>
                            <TextBlock Text="{x:Static r:Strings.Cronologia_Al}" VerticalAlignment="Center" FontSize="12"/>
                            <DatePicker SelectedDate="{Binding DataA}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.Cronologia_PercDa}" VerticalAlignment="Center" FontSize="12"/>
                            <NumericUpDown Value="{Binding PctMin}"
                                           Minimum="0" Maximum="100" Increment="5"
                                           FormatString="0"
                                           MinWidth="105" FontSize="12"/>
                            <TextBlock Text="{x:Static r:Strings.Cronologia_PercA}" VerticalAlignment="Center" FontSize="12"/>
                            <NumericUpDown Value="{Binding PctMax}"
                                           Minimum="0" Maximum="100" Increment="5"
                                           FormatString="0"
                                           MinWidth="105" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <CheckBox Content="{x:Static r:Strings.Cronologia_Concluse}" IsChecked="{Binding StatoConclusi}" FontSize="12"/>
                            <CheckBox Content="{x:Static r:Strings.Cronologia_Abbandonate}" IsChecked="{Binding StatoAbbandonati}" FontSize="12"/>
                            <CheckBox Content="{x:Static r:Strings.Stato_TempoScaduto}" IsChecked="{Binding StatoTempoScaduto}" FontSize="12"/>
                        </StackPanel>

                        <Button Content="{x:Static r:Strings.Cronologia_AzzeraFiltri}"
                                Click="OnAzzeraFiltriClick"
                                Padding="12,6"
                                FontSize="12"
                                IsEnabled="{Binding FiltriAttivi}"
                                ToolTip.Tip="{x:Static r:Strings.Cronologia_AzzeraFiltriTip}"/>

                    </WrapPanel>
                </Border>

                <!-- Stato vuoto -->
                <Border DockPanel.Dock="Top"
                        IsVisible="{Binding NessunaSessione}"
                        Margin="20,8,20,0"
                        Background="{DynamicResource SystemRegionBrush}"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="20">
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="{x:Static r:Strings.Cronologia_NessunaSessione}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TestoVuoto}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   MaxWidth="420"/>
                    </StackPanel>
                </Border>

                <!-- Header colonne (visibile solo se la lista non e' vuota e siamo su desktop) -->
                <Border x:Name="HeaderColonne"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding MostraHeaderColonne}"
                        Margin="20,8,20,0"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid ColumnDefinitions="Auto,180,*,90,90,90,160">
                        <TextBlock Text="" Width="6"/>
                        <TextBlock Grid.Column="1" Text="{x:Static r:Strings.Cronologia_ColData}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        <TextBlock Grid.Column="2" Text="{x:Static r:Strings.Cronologia_ColModalita}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                        <TextBlock Grid.Column="3" Text="%"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="{x:Static r:Strings.Cronologia_ColRisposte}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="{x:Static r:Strings.Cronologia_ColDurata}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="6" Text="" />
                    </Grid>
                </Border>

                <!-- Hint sul doppio-click -->
                <TextBlock x:Name="HintDoppioClick"
                           DockPanel.Dock="Bottom"
                           IsVisible="{Binding !NessunaSessione}"
                           Text="{x:Static r:Strings.Cronologia_DoppioClick}"
                           FontSize="11"
                           Foreground="{DynamicResource SystemBaseMediumColor}"
                           Margin="20,4,20,12"/>

                <ScrollViewer x:Name="ScrollTabella"
                              Margin="20,0,20,0"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding MostraTabella}">
                    <ListBox x:Name="ListaSessioni"
                             ItemsSource="{Binding Sessioni}"
                             SelectionMode="Single"
                             DoubleTapped="OnSessioneDoubleTapped"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="state:RisultatoCronologiaItem">
                                <Grid ColumnDefinitions="6,180,*,90,90,90,160"
                                      Margin="0,2">
                                    <Border Grid.Column="0"
                                            Width="6"
                                            Background="{Binding ColorePercentuale}"
                                            CornerRadius="3"/>

                                    <StackPanel Grid.Column="1" Spacing="2" Margin="8,2,4,2">
                                        <TextBlock Text="{Binding DataFormattata}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Static r:Strings.Stato_Abbandonato}"
                                                   FontSize="10"
                                                   Foreground="#B85450"
                                                   IsVisible="{Binding Abbandonato}"/>
                                        <TextBlock Text="{x:Static r:Strings.Cronologia_BadgeTempoScaduto}"
                                                   FontSize="10"
                                                   Foreground="#B8860B"
                                                   IsVisible="{Binding TempoScaduto}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Modalita}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MateriaEtichetta}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding PercentualeFormattata}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{Binding ColorePercentuale}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Conteggio}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="5"
                                               Text="{Binding DurataFormattata}"
                                               FontSize="12"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"/>

                                    <!-- Bottoni: stato normale.
                                         IsTabStop=False perche' altrimenti il Tab entrerebbe
                                         dentro i bottoni della riga al posto di restare sul
                                         ListBoxItem: cosi' frecce e Invio funzionano come
                                         si aspetta l'utente sulla riga selezionata. Il
                                         click di mouse continua a funzionare; per eliminare
                                         da tastiera c'e' il tasto Canc. -->
                                    <StackPanel Grid.Column="6"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                IsVisible="{Binding NonInAttesaConferma}">
                                        <Button Content="{x:Static r:Strings.Comune_Elimina}"
                                                Click="OnEliminaClick"
                                                IsTabStop="False"
                                                Classes="danger"
                                                Padding="12,4"
                                                FontSize="11"/>
                                    </StackPanel>

                                    <!-- Bottoni: stato conferma -->
                                    <StackPanel Grid.Column="6"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0"
                                                IsVisible="{Binding InAttesaConfermaEliminazione}">
                                        <Button Content="{x:Static r:Strings.Comune_SiElimina}"
                                                Click="OnConfermaEliminaClick"
                                                IsTabStop="False"
                                                Classes="danger"
                                                Padding="10,4"
                                                FontSize="11"/>
                                        <Button Content="{x:Static r:Strings.Comune_Annulla}"
                                                Click="OnAnnullaEliminaClick"
                                                IsTabStop="False"
                                                Padding="10,4"
                                                FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Lista a card (touch) — visibile solo su touch quando ci sono sessioni -->
                <ScrollViewer x:Name="ScrollCard"
                              Margin="20,0,20,0"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding MostraCard}">
                    <ListBox x:Name="ListaSessioniCard"
                             Margin="{DynamicResource SzRiservaNav}"
                             ItemsSource="{Binding Sessioni}"
                             SelectionMode="Single"
                             DoubleTapped="OnSessioneDoubleTapped"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="state:RisultatoCronologiaItem">
                                <Border Background="{DynamicResource SystemRegionBrush}"
                                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="6,*" RowDefinitions="Auto,Auto,Auto">
                                        <Border Grid.RowSpan="3" Width="6"
                                                Background="{Binding ColorePercentuale}"
                                                CornerRadius="3" Margin="0,0,10,0"/>

                                        <!-- Riga 1: data + % -->
                                        <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding DataFormattata}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{DynamicResource SzFontBody}"/>
                                                <TextBlock Text="{x:Static r:Strings.Stato_Abbandonato}" FontSize="10" Foreground="#B85450"
                                                           IsVisible="{Binding Abbandonato}"/>
                                                <TextBlock Text="{x:Static r:Strings.Cronologia_BadgeTempoScaduto}" FontSize="10" Foreground="#B8860B"
                                                           IsVisible="{Binding TempoScaduto}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PercentualeFormattata}"
                                                       FontWeight="SemiBold"
                                                       FontSize="{DynamicResource SzFontBody}"
                                                       Foreground="{Binding ColorePercentuale}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Riga 2: modalita' + materia -->
                                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Modalita}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MateriaEtichetta}" FontSize="11"
                                                       Foreground="{DynamicResource SystemBaseMediumColor}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Riga 3: conteggio/durata + Elimina -->
                                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Conteggio}" FontSize="12"/>
                                                <TextBlock Text="{Binding DurataFormattata}" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding NonInAttesaConferma}">
                                                <Button Content="{x:Static r:Strings.Comune_Elimina}" Click="OnEliminaClick"
                                                        Classes="danger" Padding="{DynamicResource SzBtnPadding}"
                                                        FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding InAttesaConfermaEliminazione}">
                                                <Button Content="{x:Static r:Strings.Comune_SiElimina}" Click="OnConfermaEliminaClick"
                                                        Classes="danger" Padding="{DynamicResource SzBtnPadding}" FontSize="11"/>
                                                <Button Content="{x:Static r:Strings.Comune_Annulla}" Click="OnAnnullaEliminaClick"
                                                        Padding="{DynamicResource SzBtnPadding}" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>

            <!-- DETTAGLIO -->
            <ContentControl x:Name="DettaglioArea"
                            IsVisible="{Binding ModoDettaglio}"/>
        </Grid>

    </DockPanel>

</UserControl>
