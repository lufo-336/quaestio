<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.GestioneContenutiView"
             x:DataType="views:GestioneContenutiView">

    <ScrollViewer Margin="20,16,20,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="{DynamicResource SzRiservaNav}">

            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static r:Strings.Shell_TabGestione}" FontFamily="{DynamicResource FontTitoli}" FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{Binding Sottotitolo}"
                           FontSize="12"
                           Foreground="{DynamicResource TestoAttenuato}"/>
            </StackPanel>

            <Border Background="{DynamicResource SfondoRialzato}"
                    BorderBrush="{DynamicResource RigaDebole}"
                    BorderThickness="1"
                    Padding="14">
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sessioni}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="state:MateriaListItem">
                                <Expander Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Etichetta}" FontWeight="SemiBold" FontSize="14"/>
                                                    <Border Background="{DynamicResource RigaDebole}"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding Badge}" FontSize="10"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ConteggioEtichetta}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TestoAttenuato}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                                        IsVisible="{Binding Importata}">
                                                <Button Content="{x:Static r:Strings.Comune_Elimina}" Click="OnEliminaClick"
                                                        IsTabStop="False" Classes="danger"
                                                        Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                        IsVisible="{Binding NonInAttesaConferma}"/>
                                                <TextBlock Text="{x:Static r:Strings.Comune_Sicuro}" VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{DynamicResource RossoTestoBrush}" FontWeight="SemiBold"
                                                           IsVisible="{Binding InAttesaConfermaEliminazione}"/>
                                                <Button Content="{x:Static r:Strings.Comune_SiElimina}" Click="OnConfermaEliminaClick"
                                                        IsTabStop="False" Classes="danger"
                                                        Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                        IsVisible="{Binding InAttesaConfermaEliminazione}"/>
                                                <Button Content="{x:Static r:Strings.Comune_Annulla}" Click="OnAnnullaEliminaClick"
                                                        IsTabStop="False"
                                                        Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                        IsVisible="{Binding InAttesaConfermaEliminazione}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>

                                    <!-- Sezioni (categorie) della materia: nascondi / ripristina -->
                                    <ItemsControl ItemsSource="{Binding Sezioni}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="state:SezioneListItem">
                                                <Grid ColumnDefinitions="*,Auto" Margin="4,4"
                                                      Opacity="{Binding OpacitaRiga}">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Etichetta}" FontSize="13"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ConteggioEtichetta}"
                                                                   FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TestoAttenuato}"/>
                                                        <Border Background="{DynamicResource RigaDebole}"
                                                                Padding="6,2"
                                                                IsVisible="{Binding Esclusa}">
                                                            <TextBlock Text="{x:Static r:Strings.Gestione_Nascosta}" FontSize="10"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                                VerticalAlignment="Center">
                                                        <Button Content="{x:Static r:Strings.Gestione_Nascondi}" Click="OnNascondiSezioneClick"
                                                                IsTabStop="False" Classes="danger"
                                                                Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                                IsVisible="{Binding MostraBottoneNascondi}"/>
                                                        <Button Content="{x:Static r:Strings.Gestione_SiNascondi}" Click="OnConfermaNascondiSezioneClick"
                                                                IsTabStop="False" Classes="danger"
                                                                Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                                IsVisible="{Binding MostraConfermaNascondi}"/>
                                                        <Button Content="{x:Static r:Strings.Comune_Annulla}" Click="OnAnnullaNascondiSezioneClick"
                                                                IsTabStop="False"
                                                                Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                                IsVisible="{Binding MostraConfermaNascondi}"/>
                                                        <Button Content="{x:Static r:Strings.Gestione_Ripristina}" Click="OnRipristinaSezioneClick"
                                                                IsTabStop="False" Classes="accent"
                                                                Padding="{DynamicResource SzBtnPadding}" FontSize="12"
                                                                IsVisible="{Binding Esclusa}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border Background="{DynamicResource SfondoRialzato}"
                    BorderBrush="{DynamicResource RigaDebole}"
                    BorderThickness="1" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static r:Strings.Gestione_NuovaMateria}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="{x:Static r:Strings.Gestione_NuovaMateriaPassi}"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                    <TextBox x:Name="NomeNuovaMateria" PlaceholderText="{x:Static r:Strings.Gestione_NomeMateria}"
                             TextChanged="OnNomeNuovaMateriaChanged"/>
                    <Button x:Name="BottoneImportNuova" Content="{x:Static r:Strings.Gestione_ImportaJson}"
                            Click="OnScegliFileNuovaMateriaClick" IsEnabled="False"
                            Classes="accent" Padding="{DynamicResource SzBtnPadding}"/>
                    <TextBlock x:Name="EsitoNuovaMateria" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SfondoRialzato}"
                    BorderBrush="{DynamicResource RigaDebole}"
                    BorderThickness="1" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static r:Strings.Gestione_AggiungiTitolo}" FontWeight="SemiBold" FontSize="15"/>
                    <ComboBox x:Name="SelettoreMateria" ItemsSource="{Binding Sessioni}"
                              PlaceholderText="{x:Static r:Strings.Gestione_ScegliMateria}"
                              SelectionChanged="OnSelettoreMateriaChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="state:MateriaListItem">
                                <TextBlock Text="{Binding Etichetta}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="BottoneImportAggiungi" Content="{x:Static r:Strings.Gestione_ImportaJson}"
                            Click="OnScegliFileAggiungiClick" IsEnabled="False"
                            Classes="accent" Padding="{DynamicResource SzBtnPadding}"/>
                    <TextBlock x:Name="EsitoAggiungi" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TestoAttenuato}"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SfondoRialzato}"
                    BorderBrush="{DynamicResource RigaDebole}"
                    BorderThickness="1" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Static r:Strings.Gestione_IaTitolo}" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{DynamicResource TestoAttenuato}"
                               Text="{x:Static r:Strings.Gestione_IaDescrizione}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{x:Static r:Strings.Gestione_ScaricaGuida}" Click="OnScaricaGuidaClick" Padding="{DynamicResource SzBtnPadding}"/>
                        <Button Content="{x:Static r:Strings.Gestione_ScaricaMotore}" Click="OnScaricaMotoreClick" Padding="{DynamicResource SzBtnPadding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="PannelloAnteprima" IsVisible="False"
                    Background="{DynamicResource SfondoRialzato}"
                    BorderBrush="{DynamicResource RigaDebole}"
                    BorderThickness="1" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="AnteprimaTitoloText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AnteprimaLista"/>
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BottoneConferma" Content="{x:Static r:Strings.Gestione_Conferma}" Click="OnConfermaImportClick"
                                Classes="accent" Padding="{DynamicResource SzBtnPadding}"/>
                        <Button Content="{x:Static r:Strings.Comune_Annulla}" Click="OnAnnullaImportClick"
                                Padding="{DynamicResource SzBtnPadding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
