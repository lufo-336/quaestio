<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stats="using:Wsa.Quiz.Core.Models.Statistiche"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:views="using:Wsa.Quiz.App.Views"
             xmlns:c="using:Wsa.Quiz.App.Controls"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.StatisticheView"
             x:DataType="views:StatisticheView">

    <UserControl.Styles>
        <Style Selector="Border.materiaCard">
            <Setter Property="Background" Value="{DynamicResource SystemRegionBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.materiaCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
        </Style>
        <Style Selector="Border.materiaCard.selezionata">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="11,9"/>
        </Style>

        <Style Selector="Button.filtro">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>
        <Style Selector="Button.filtro.attivo /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoBrush}"/>
        </Style>
        <Style Selector="Button.filtro.attivo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoHoverBrush}"/>
        </Style>
        <Style Selector="Button.filtro.attivo:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentoPressedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentoPressedBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- ============================== HEADER ============================== -->
        <Grid x:Name="HeaderGrid"
              DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="20,16,20,10">
            <StackPanel Spacing="6">
                <TextBlock Text="{x:Static r:Strings.Shell_TabStatistiche}"
                           FontSize="{DynamicResource SzFontTitolo}"
                           FontWeight="SemiBold"/>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Niente GroupName: vedi Trappola 19. -->
                    <RadioButton Content="{x:Static r:Strings.Statistiche_Tutto}"
                                 IsChecked="{Binding ModalitaTutto}"
                                 Margin="0,0,10,0"/>
                    <RadioButton Content="{x:Static r:Strings.Statistiche_Ultime}"
                                 IsChecked="{Binding !ModalitaTutto}"
                                 Margin="0,0,10,0"/>
                    <NumericUpDown Value="{Binding LimiteUltimeN}"
                                   Minimum="1"
                                   Maximum="9999"
                                   Increment="1"
                                   FormatString="0"
                                   Width="100"
                                   IsEnabled="{Binding !ModalitaTutto}"
                                   ValueChanged="OnLimiteChanged"
                                   Margin="0,0,10,0"/>
                    <TextBlock Text="{x:Static r:Strings.Statistiche_Partite}"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                </WrapPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{x:Static r:Strings.Comune_Aggiorna}"
                    Click="OnAggiornaClick"
                    Padding="14,6"
                    FontSize="12"
                    VerticalAlignment="Top"/>
        </Grid>

        <!-- ============================== CORPO ============================== -->
        <Grid>

            <!-- EMPTY: cronologia totalmente vuota -->
            <Border IsVisible="{Binding NessunDato}"
                    Margin="20,8,20,16"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SystemRegionBrush}"
                    BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="{x:Static r:Strings.Statistiche_NessunQuiz}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static r:Strings.Statistiche_NessunQuizDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="460"/>
                </StackPanel>
            </Border>

            <!-- EMPTY: filtro periodo troppo stretto -->
            <Border IsVisible="{Binding FiltroTroppoStretto}"
                    Margin="20,8,20,16"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SystemRegionBrush}"
                    BorderBrush="{DynamicResource SystemBaseLowColor}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">
                <StackPanel HorizontalAlignment="Center" Spacing="6">
                    <TextBlock Text="{x:Static r:Strings.Statistiche_FiltroStretto}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static r:Strings.Statistiche_FiltroStrettoDesc}"
                               FontSize="12"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="460"/>
                </StackPanel>
            </Border>

            <!-- MASTER-DETAIL (Desktop: split 2 colonne; Touch: 2 step) -->
            <Grid x:Name="ContenutoGrid"
                  ColumnDefinitions="260,12,*"
                  Margin="20,0,20,16"
                  IsVisible="{Binding ContenutoVisibile}">

                <!-- PANNELLO 1: LISTA MATERIE -->
                <ScrollViewer x:Name="PannelloMaterie"
                              Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding MostraListaMaterie}">
                    <StackPanel Spacing="8" Margin="{DynamicResource SzRiservaNav}">
                        <TextBlock Text="{x:Static r:Strings.Statistiche_Sottotitolo}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                   IsVisible="{Binding MostraSottotitoloMaterie}"
                                   Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Materie}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="state:MateriaStatItem">
                                    <Border Classes="materiaCard"
                                            Classes.selezionata="{Binding IsSelected}"
                                            Margin="0,0,0,8"
                                            Cursor="Hand"
                                            PointerPressed="OnMateriaPressed">
                                        <StackPanel Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding MateriaMostrata}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding PctFormattata}"
                                                           Foreground="{Binding ColoreLivello}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                                <Button Grid.Column="2"
                                                        Content="{Binding EtichettaRipassaBreve}"
                                                        Click="OnRipassaMateriaCardClick"
                                                        Classes="accent"
                                                        Padding="10,4"
                                                        FontSize="12"
                                                        Margin="10,0,0,0"
                                                        IsVisible="{Binding MostraRipassaSuCard}"/>
                                            </Grid>

                                            <c:BarraLivelli Rosse="{Binding CountRosse}"
                                                            Ambra="{Binding CountAmbra}"
                                                            Verdi="{Binding CountVerdi}"
                                                            Height="5"/>

                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HaRosse}">
                                                        <Ellipse Width="8" Height="8" Fill="#B85450" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CountRosse}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HaAmbra}">
                                                        <Ellipse Width="8" Height="8" Fill="#B8860B" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CountAmbra}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HaVerdi}">
                                                        <Ellipse Width="8" Height="8" Fill="#1F7A4D" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CountVerdi}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding RiepilogoDettaglio}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- PANNELLO 2: DETTAGLIO MATERIA -->
                <Border x:Name="PannelloDettaglio"
                        Grid.Column="2"
                        Background="{DynamicResource SystemRegionBrush}"
                        BorderBrush="{DynamicResource SystemBaseLowColor}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        IsVisible="{Binding MostraDettaglioMateria}">
                    <DockPanel>

                        <!-- Intestazione materia + selettori -->
                        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,12">

                            <!-- Riga titolo + Indietro (touch) + Ripassa materia -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
                                        <Button Content="{x:Static r:Strings.Statistiche_IndietroMaterie}"
                                                Click="OnIndietroMaterieClick"
                                                Padding="10,4"
                                                FontSize="12"
                                                IsVisible="{Binding MostraIndietro}"/>
                                        <TextBlock Text="{Binding MateriaTitolo}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MateriaPct}"
                                                   Foreground="{Binding MateriaColore}"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding MateriaRiepilogo}"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="{Binding MateriaEtichettaRipassa}"
                                        Click="OnRipassaMateriaClick"
                                        Classes="accent"
                                        Padding="14,6"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        IsVisible="{Binding MateriaHaSbagliate}"/>
                            </Grid>

                            <!-- Selettori: filtro livello + ordinamento -->
                            <WrapPanel ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
                                <Button Classes="filtro"
                                        Classes.attivo="{Binding FiltroTutteAttivo}"
                                        Content="{Binding EtichettaFiltroTutte}"
                                        Tag=""
                                        Click="OnFiltroLivelloClick"/>
                                <Button Classes="filtro"
                                        Classes.attivo="{Binding FiltroRosseAttivo}"
                                        Tag="rosse"
                                        Click="OnFiltroLivelloClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#B85450" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EtichettaFiltroRosse}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="filtro"
                                        Classes.attivo="{Binding FiltroAmbraAttivo}"
                                        Tag="ambra"
                                        Click="OnFiltroLivelloClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#B8860B" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EtichettaFiltroAmbra}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Classes="filtro"
                                        Classes.attivo="{Binding FiltroVerdiAttivo}"
                                        Tag="verdi"
                                        Click="OnFiltroLivelloClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#1F7A4D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EtichettaFiltroVerdi}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <ComboBox SelectedIndex="{Binding IndiceOrdinamento}"
                                          MinWidth="140"
                                          FontSize="12"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="{x:Static r:Strings.Statistiche_OrdinaPiuDeboli}"/>
                                    <ComboBoxItem Content="{x:Static r:Strings.Statistiche_OrdinaAlfabetico}"/>
                                    <ComboBoxItem Content="{x:Static r:Strings.Statistiche_OrdinaPiuViste}"/>
                                </ComboBox>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Elenco ordinato delle categorie -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="{DynamicResource SzRiservaNav}">
                                <TextBlock Text="{x:Static r:Strings.Statistiche_NessunaCategoriaFiltro}"
                                           FontSize="13"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource SystemBaseMediumColor}"
                                           IsVisible="{Binding NessunaCategoriaFiltrata}"
                                           Margin="4,12"/>

                                <ItemsControl ItemsSource="{Binding CategorieFiltrate}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="state:CategoriaStatItem">
                                            <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="4,*">
                                                    <!-- Barra laterale colorata per livello -->
                                                    <Border Grid.Column="0"
                                                            Background="{Binding ColoreLivello}"/>

                                                    <StackPanel Grid.Column="1">
                                                        <!-- Riga categoria (cliccabile per espandere gli errori) -->
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              Background="Transparent"
                                                              Cursor="Hand"
                                                              PointerPressed="OnCategoriaPressed"
                                                              Margin="12,10">
                                                            <StackPanel Spacing="5" VerticalAlignment="Center">
                                                                <WrapPanel ItemSpacing="8" LineSpacing="2">
                                                                    <TextBlock Text="{Binding NomeMostrato}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="14"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding PctFormattata}"
                                                                               Foreground="{Binding ColoreLivello}"
                                                                               FontWeight="Bold"
                                                                               FontSize="13"
                                                                               VerticalAlignment="Center"/>
                                                                </WrapPanel>
                                                                <WrapPanel ItemSpacing="10" LineSpacing="4" VerticalAlignment="Center">
                                                                    <c:BarraErrore Valore="{Binding PctErrore}"
                                                                                   Colore="{Binding ColoreLivello}"
                                                                                   Width="84"
                                                                                   Height="5"
                                                                                   VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding RiepilogoNumeri}"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                               VerticalAlignment="Center"/>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding FrecciaEspansione}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                                   IsVisible="{Binding HaSbagliate}"/>
                                                                        <TextBlock Text="{Binding EtichettaSbagliate}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource SystemBaseMediumColor}"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                            </StackPanel>

                                                            <Button Grid.Column="1"
                                                                    Content="{Binding EtichettaRipassa}"
                                                                    Click="OnRipassaCategoriaClick"
                                                                    Classes="accent"
                                                                    Padding="11,5"
                                                                    FontSize="12"
                                                                    VerticalAlignment="Center"
                                                                    Margin="10,0,0,0"
                                                                    IsVisible="{Binding HaSbagliate}"/>
                                                        </Grid>

                                                        <!-- Domande sbagliate espandibili inline -->
                                                        <Border BorderBrush="{DynamicResource SystemBaseLowColor}"
                                                                BorderThickness="0,1,0,0"
                                                                Padding="12,10"
                                                                IsVisible="{Binding MostraSbagliateInline}">
                                                            <ItemsControl ItemsSource="{Binding Sbagliate}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="stats:DomandaSbagliata">
                                                                        <Border Background="{DynamicResource SystemRegionBrush}"
                                                                                BorderBrush="{DynamicResource SystemBaseLowColor}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="5"
                                                                                Padding="10,8"
                                                                                Margin="0,0,0,6">
                                                                            <StackPanel Spacing="5">
                                                                                <TextBlock FontWeight="SemiBold"
                                                                                           Foreground="#B85450"
                                                                                           FontSize="12">
                                                                                    <Run Text="{x:Static r:Strings.Statistiche_SbagliataPrefisso}"/>
                                                                                    <Run Text="{Binding VolteSbagliata}"/>
                                                                                    <Run Text="/"/>
                                                                                    <Run Text="{Binding VolteVista}"/>
                                                                                    <Run Text="{x:Static r:Strings.Statistiche_VolteSuffisso}"/>
                                                                                </TextBlock>
                                                                                <c:TestoConCodice Testo="{Binding Testo}"/>
                                                                                <Grid ColumnDefinitions="Auto,*">
                                                                                    <TextBlock Text="{x:Static r:Strings.Statistiche_CorrettaPrefisso}"
                                                                                               Foreground="#1F7A4D"
                                                                                               FontSize="12"
                                                                                               Margin="0,0,4,0"/>
                                                                                    <c:TestoConCodice Grid.Column="1"
                                                                                                      Testo="{Binding RispostaCorretta}"
                                                                                                      Foreground="#1F7A4D"
                                                                                                      FontSize="12"/>
                                                                                </Grid>
                                                                                <c:TestoConCodice Testo="{Binding Spiegazione}"
                                                                                                  FontStyle="Italic"
                                                                                                  FontSize="12"
                                                                                                  Foreground="{DynamicResource SystemBaseMediumColor}"
                                                                                                  IsVisible="{Binding Spiegazione, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                    </DockPanel>
                </Border>

            </Grid>

        </Grid>

    </DockPanel>

</UserControl>
