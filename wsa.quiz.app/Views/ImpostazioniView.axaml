<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="using:Wsa.Quiz.App.Views"
             xmlns:state="using:Wsa.Quiz.App.State"
             xmlns:r="clr-namespace:Wsa.Quiz.Core.Risorse;assembly=Wsa.Quiz.Core"
             mc:Ignorable="d"
             x:Class="Wsa.Quiz.App.Views.ImpostazioniView"
             x:DataType="views:ImpostazioniView">

    <UserControl.Styles>
        <Style Selector="Button.pallino">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.pallino /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.pallino:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
        </Style>
        <Style Selector="Button.pallino:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{TemplateBinding Background}"/>
            <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- ======================================== HEADER -->
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="*,Auto"
              Margin="20,16,20,8">
            <StackPanel Spacing="2">
                <TextBlock Text="{x:Static r:Strings.Shell_TabImpostazioni}"
                           FontFamily="{DynamicResource FontTitoli}"
                           FontSize="22" FontWeight="ExtraBold"/>
                <TextBlock Text="{x:Static r:Strings.Impostazioni_Sottotitolo}"
                           FontSize="12"
                           Foreground="{DynamicResource TestoAttenuato}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer>
            <Border Padding="{DynamicResource SzRiservaNav}">
            <StackPanel Margin="20,8,20,20" Spacing="16">
                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.Impostazioni_Tema}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Static r:Strings.Impostazioni_TemaDescrizione}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TestoAttenuato}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="TemaToggle"
                                      OnContent="{x:Static r:Strings.Impostazioni_TemaScuro}"
                                      OffContent="{x:Static r:Strings.Impostazioni_TemaChiaro}"
                                      IsChecked="{Binding TemaScuro}"/>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.Impostazioni_Colore}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Static r:Strings.Impostazioni_ColoreDescrizione}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TestoAttenuato}"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding ColoriDisponibili}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="state:ColoreSelezionabile">
                                    <Button Classes="pallino"
                                            Width="28" Height="28"
                                            MinWidth="0" MinHeight="0"
                                            Padding="0"
                                            BorderThickness="3"
                                            Background="{Binding Pennello}"
                                            BorderBrush="{Binding BordoSelezione}"
                                            ToolTip.Tip="{Binding Nome}"
                                            AutomationProperties.Name="{Binding Nome}"
                                            Margin="4"
                                            Click="OnColoreClick"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.Lingua_Nome}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Static r:Strings.Lingua_Descrizione}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TestoAttenuato}"/>
                            <TextBlock Text="{x:Static r:Strings.Lingua_BloccataDuranteQuiz}"
                                       IsVisible="{Binding QuizInCorso}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource AmbraTestoBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1"
                                  MinWidth="130"
                                  VerticalAlignment="Center"
                                  Margin="12,0,0,0"
                                  ItemsSource="{Binding LingueDisponibili}"
                                  SelectedItem="{Binding LinguaSelezionata}"
                                  IsEnabled="{Binding LinguaModificabile}"/>
                    </Grid>
                </Border>

                <!-- ======================================== ABOUT (step 14) -->

                <TextBlock Text="{x:Static r:Strings.Impostazioni_Informazioni}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="2,8,0,0"/>

                <!-- App e versione -->
                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Quaestio" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Versione}"
                                       FontSize="13"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource TestoAttenuato}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Static r:Strings.Impostazioni_DescrizioneApp}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                    </StackPanel>
                </Border>

                <!-- Contenuti caricati -->
                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Static r:Strings.Impostazioni_Contenuti}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ContenutiEtichetta}" FontSize="12"/>
                        <TextBlock Text="{x:Static r:Strings.Impostazioni_ContenutiNota}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                    </StackPanel>
                </Border>

                <!-- Cartella dati -->
                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Static r:Strings.Impostazioni_Dati}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DatiDescrizione}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TestoAttenuato}"/>
                            <SelectableTextBlock Text="{Binding PercorsoDati}"
                                                 IsVisible="{Binding MostraPercorsoDati}"
                                                 FontSize="11"
                                                 FontFamily="monospace"
                                                 TextWrapping="Wrap"
                                                 Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{x:Static r:Strings.Impostazioni_ApriCartella}"
                                Click="OnApriCartellaClick"
                                IsVisible="{Binding MostraApriCartella}"
                                Padding="14,6"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Crediti -->
                <Border Background="{DynamicResource SfondoRialzato}"
                        BorderBrush="{DynamicResource RigaDebole}"
                        BorderThickness="1"
                        Padding="16,14">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Static r:Strings.Impostazioni_Crediti}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Static r:Strings.Impostazioni_CreditiTesto}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TestoAttenuato}"/>
                        <Button Content="{x:Static r:Strings.Impostazioni_VaiRepo}"
                                Click="OnApriRepoClick"
                                Padding="14,6"
                                FontSize="12"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

            </StackPanel>
            </Border>
        </ScrollViewer>

    </DockPanel>

</UserControl>
