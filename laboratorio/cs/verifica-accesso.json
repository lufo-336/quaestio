{
  "id": "verifica-accesso",
  "titolo": "Verifica accesso per email e ruolo",
  "livello": "media",
  "requisito": "Dato un indirizzo email, un ruolo e una lista di ruoli ammessi, restituisce il ruolo ammesso in minuscolo se il dominio dell'email è esattamente azienda.it (ignorando spazi ai bordi e maiuscole/minuscole) e il ruolo figura tra quelli ammessi; altrimenti restituisce \"negato\".",
  "chiamata": "Console.WriteLine(VerificaAccesso(\" Luca@Azienda.it \", \"admin\", new[] { \"User\", \"Admin\" }));\nConsole.WriteLine(VerificaAccesso(\"anna@azienda.it\", \"EDITOR\", new[] { \"editor\", \"admin\" }));\nConsole.WriteLine(VerificaAccesso(\"sara@azienda.it\", \"Viewer\", new[] { \"viewer\" }));",
  "codiceSano": [
    "string VerificaAccesso(string? email, string? ruolo, string?[]? ruoli)",
    "{",
    "    if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(ruolo))",
    "        return \"negato\";",
    "    if (ruoli == null || ruoli.Length == 0)",
    "        return \"negato\";",
    "    string pulita = email.Trim();",
    "    int chiocciola = pulita.IndexOf('@');",
    "    if (chiocciola <= 0)",
    "        return \"negato\";",
    "    string dominio = pulita.Substring(chiocciola + 1);",
    "    if (!string.Equals(dominio, \"azienda.it\", StringComparison.OrdinalIgnoreCase))",
    "        return \"negato\";",
    "    string target = ruolo.Trim();",
    "    foreach (string? r in ruoli)",
    "    {",
    "        string voce = (r ?? \"\").Trim();",
    "        if (string.Equals(voce, target, StringComparison.OrdinalIgnoreCase))",
    "            return voce.ToLowerInvariant();",
    "    }",
    "    return \"negato\";",
    "}"
  ],
