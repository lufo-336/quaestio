    "{",
    "    if (prezzi.Length != quantita.Length || prezzi.Length == 0)",
    "        return 0;",
    "    int subtotale = 0;",
    "    for (int i = 0; i < prezzi.Length; i++)",
    "    {",
    "        if (prezzi[i] <= 0 || quantita[i] <= 0)",
    "            continue;",
    "        subtotale += prezzi[i] * quantita[i];",
    "    }",
    "    int percentualeSconto = 0;",
    "    if (subtotale >= 200)",
    "        percentualeSconto = 20;",
    "    else if (subtotale >= 100)",
    "        percentualeSconto = 10;",
    "    if (clienteVip && percentualeSconto < 20)",
    "        percentualeSconto += 5;",
    "    double sconto = subtotale * percentualeSconto / 100.0;",
    "    return Math.Round(subtotale - sconto, 2);",
    "}"
