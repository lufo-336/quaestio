{
  "id": "pulizia-cache-ttl",
  "titolo": "Cache in memoria con scadenza TTL",
  "livello": "alta",
  "requisito": "Simula una sequenza di comandi \"PUT:istante:chiave\" e \"GET:istante:chiave\" su una cache con durata ttl (una voce creata o aggiornata a t0 scade appena istante - t0 >= ttl; ogni comando rimuove prima le voci scadute). Restituisce \"non valido\" se operazioni è nullo o vuoto oppure ttl <= 0; altrimenti restituisce il numero di voci attive, i hit sulle richieste GET e la percentuale di hit arrotondata a una cifra decimale.",
  "chiamata": "Console.WriteLine(SimulaCacheTtl(new[] { \"PUT:0:a\", \"PUT:2:a\", \"GET:4:a\", \"GET:5:b\" }, 10, false));\nConsole.WriteLine(SimulaCacheTtl(new[] { \"PUT:0:a\", \"PUT:0:b\", \"GET:1:a\", \"GET:2:a\", \"GET:3:a\", \"GET:4:x\", \"GET:5:x\", \"GET:6:x\", \"GET:7:x\", \"GET:8:x\" }, 10, false));\nConsole.WriteLine(SimulaCacheTtl(new[] { \"PUT:0:a\", \"PUT:1:b\", \"GET:5:a\", \"GET:5:b\" }, 5, false));",
  "codiceSano": [
    "string SimulaCacheTtl(string?[]? operazioni, int ttl, bool caseSensitive)",
    "{",
    "    if (operazioni == null || operazioni.Length == 0 || ttl <= 0)",
    "        return \"non valido\";",
    "",
    "    var cache = new List<(string Chiave, int CreatoA)>();",
    "    var modo = caseSensitive",
    "        ? StringComparison.Ordinal",
    "        : StringComparison.OrdinalIgnoreCase;",
    "    int hits = 0;",
    "    int richieste = 0;",
    "",
    "    foreach (string? raw in operazioni)",
    "    {",
    "        if (string.IsNullOrWhiteSpace(raw))",
    "            continue;",
    "        string[] parti = raw.Trim().Split(':');",
    "        if (parti.Length != 3)",
    "            continue;",
    "",
    "        string azione = parti[0].Trim().ToUpperInvariant();",
    "        int istante = int.Parse(parti[1].Trim());",
    "        string chiave = parti[2].Trim();",
    "",
    "        for (int j = cache.Count - 1; j >= 0; j--)",
    "        {",
    "            if (istante - cache[j].CreatoA >= ttl)",
    "                cache.RemoveAt(j);",
    "        }",
    "",
    "        int indice = -1;",
    "        for (int j = 0; j < cache.Count; j++)",
    "        {",
    "            if (string.Equals(cache[j].Chiave, chiave, modo))",
    "            {",
    "                indice = j;",
    "                break;",
    "            }",
    "        }",
    "",
    "        if (azione == \"PUT\")",
    "        {",
    "            if (indice >= 0)",
    "                cache[indice] = (cache[indice].Chiave, istante);",
    "            else",
    "                cache.Add((chiave, istante));",
    "        }",
    "        else if (azione == \"GET\")",
    "        {",
    "            richieste++;",
    "            if (indice >= 0)",
    "                hits++;",
    "        }",
    "    }",
    "",
    "    double tasso = richieste == 0 ? 0 : Math.Round(hits * 100.0 / richieste, 1);",
    "    return $\"attive={cache.Count}; hit={hits}/{richieste} ({tasso}%)\";",
    "}"
  ],
