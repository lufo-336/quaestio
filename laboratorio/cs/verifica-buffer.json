{
  "id": "verifica-buffer",
  "titolo": "Verifica spazio buffer video",
  "livello": "media",
  "requisito": "Calcola lo spazio totale in MB occupato da una sequenza di clip video (larghezza w, altezza h, canali per pixel e numero di fotogrammi per clip). Restituisce \"non valido\" se i parametri non sono positivi, se l'array di clip è nullo o vuoto o se una clip ha fotogrammi negativi (o pari a 0 quando consentiVuote è false); altrimenti restituisce \"ok (N MB)\" o \"eccede (N MB)\" rispetto a maxMb.",
  "chiamata": "Console.WriteLine(VerificaBuffer(1024, 1024, 4, new[] { 25, 0 }, 200, true));\nConsole.WriteLine(VerificaBuffer(1024, 1024, 4, new[] { 300, 212 }, 1000, false));\nConsole.WriteLine(VerificaBuffer(1024, 1024, 4, new[] { 50, -10 }, 500, true));",
  "codiceSano": [
    "string VerificaBuffer(int w, int h, int canali, int[]? clip, int maxMb, bool consentiVuote)",
    "{",
    "    if (w <= 0 || h <= 0 || canali <= 0 || maxMb <= 0)",
    "        return \"non valido\";",
    "    if (clip == null || clip.Length == 0)",
    "        return \"non valido\";",
    "    int fotogrammi = 0;",
    "    foreach (int f in clip)",
    "    {",
    "        if (f < 0 || (!consentiVuote && f == 0))",
    "            return \"non valido\";",
    "        fotogrammi += f;",
    "    }",
    "    long byteTotali = (long)w * h * canali * fotogrammi;",
    "    long mbTotali = byteTotali / (1024 * 1024);",
    "    if (mbTotali > maxMb)",
    "        return $\"eccede ({mbTotali} MB)\";",
    "    return $\"ok ({mbTotali} MB)\";",
    "}"
  ],
  "varianti": [
    {
