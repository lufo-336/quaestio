        "    int fotogrammi = 0;",
        "    foreach (int f in clip)",
        "    {",
        "        if (f < 0 || (!consentiVuote && f == 0))",
        "            return \"non valido\";",
        "        fotogrammi += f;",
        "    }",
        "    long byteTotali = w * h * canali * fotogrammi;",
        "    long mbTotali = byteTotali / (1024 * 1024);",
        "    if (mbTotali > maxMb)",
        "        return $\"eccede ({mbTotali} MB)\";",
        "    return $\"ok ({mbTotali} MB)\";",
        "}"
      ],
      "output": [ "ok (100 MB)", "ok (-2048 MB)", "non valido" ],
