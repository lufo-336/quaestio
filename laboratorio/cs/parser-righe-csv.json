{
  "id": "parser-righe-csv",
  "titolo": "Analisi e somma di righe CSV",
  "livello": "alta",
  "requisito": "Analizza un array di righe CSV nel formato \"prodotto;categoria;quantita;prezzo\" (saltando eventualmente la prima riga di intestazione, le righe vuote e i commenti che iniziano con '#'). Ogni riga dati deve avere 4 campi, testi non vuoti e numeri interi non negativi, altrimenti lancia FormatException. Calcola il numero di righe valide, il totale complessivo e il totale della categoria filtrata (case-insensitive, oppure uguale al totale complessivo se il filtro è vuoto); se righe è nullo o vuoto restituisce \"nessun dato\".",
  "chiamata": "Console.WriteLine(AnalizzaOrdiniCsv(new[] { \"Prod;Cat;Qta;Prezzo\", \"Mouse;Tech;2;25\", \"Cavo;Tech;1;10\" }, \"Tech\", true));\nConsole.WriteLine(AnalizzaOrdiniCsv(new[] { \"Penna;Ufficio;4;3\", \"Carta;Ufficio;2;5\" }, \"ufficio\", false));\nConsole.WriteLine(AnalizzaOrdiniCsv(new[] { \"Sedia;Arredo;2;40\", \"Lampada;Arredo;1;20\" }, \"\", false));",
  "codiceSano": [
    "string AnalizzaOrdiniCsv(string?[]? righe, string? categoriaFiltro, bool saltaIntestazione)",
    "{",
    "    if (righe == null || righe.Length == 0)",
    "        return \"nessun dato\";",
    "",
    "    string filtro = (categoriaFiltro ?? string.Empty).Trim();",
    "    bool haFiltro = filtro.Length > 0;",
    "    int inizio = saltaIntestazione ? 1 : 0;",
    "    int conteggio = 0;",
    "    long totaleGenerale = 0;",
    "    long totaleFiltro = 0;",
    "",
    "    for (int i = inizio; i < righe.Length; i++)",
    "    {",
    "        string? grezza = righe[i];",
    "        if (string.IsNullOrWhiteSpace(grezza))",
    "            continue;",
    "",
    "        string riga = grezza.Trim();",
    "        if (riga.StartsWith(\"#\", StringComparison.Ordinal))",
    "            continue;",
    "",
    "        string[] campi = riga.Split(';');",
    "        if (campi.Length != 4)",
    "            throw new FormatException(\"Numero di colonne non valido\");",
    "",
    "        string prodotto = campi[0].Trim();",
    "        string categoria = campi[1].Trim();",
    "        if (prodotto.Length == 0 || categoria.Length == 0)",
    "            throw new FormatException(\"Campi testuali vuoti\");",
    "",
    "        int qta = int.Parse(campi[2].Trim());",
    "        int prezzo = int.Parse(campi[3].Trim());",
    "        if (qta < 0 || prezzo < 0)",
    "            throw new FormatException(\"Valori negativi\");",
    "",
    "        long subtotale = (long)qta * prezzo;",
    "        totaleGenerale += subtotale;",
    "        if (!haFiltro || string.Equals(categoria, filtro, StringComparison.OrdinalIgnoreCase))",
    "            totaleFiltro += subtotale;",
    "        conteggio++;",
    "    }",
    "",
    "    return $\"righe={conteggio}; totale={totaleGenerale}; filtro={totaleFiltro}\";",
    "}"
  ],
