{
  "id": "paginazione-catalogo",
  "titolo": "Paginazione e filtro del catalogo",
  "livello": "alta",
  "requisito": "Filtra le voci valide di un catalogo (ignorando elementi nulli o vuoti) per sottostringa case-insensitive se filtro non è vuoto, poi restituisce la pagina 1-based con la quota percentuale mostrata rispetto al totale filtrato. Restituisce \"non valido\" se voci è nullo o pagina/perPagina non sono positivi; se non ci sono voci o la pagina è oltre la fine, restituisce una lista vuota.",
  "chiamata": "Console.WriteLine(PaginaCatalogo(new[] { \"Cavo USB\", \"Mouse\", \"Hub USB\", \"Microfono usb\", \"Webcam USB\" }, \"usb\", 1, 2));\nConsole.WriteLine(PaginaCatalogo(new[] { \"A1\", \"A2\", \"A3\", \"A4\", \"A5\", \"A6\", \"A7\", \"A8\" }, null, 1, 3));\nConsole.WriteLine(PaginaCatalogo(new[] { \"Monitor\", \"Cuffie\", \"Tastiera\", \"Mouse\" }, \"\", 2, 2));",
  "codiceSano": [
    "string PaginaCatalogo(string?[]? voci, string? filtro, int pagina, int perPagina)",
    "{",
    "    if (voci == null || pagina <= 0 || perPagina <= 0)",
    "        return \"non valido\";",
    "",
    "    var filtrate = new List<string>();",
    "    string chiave = (filtro ?? string.Empty).Trim();",
    "    bool haFiltro = chiave.Length > 0;",
    "",
    "    foreach (string? raw in voci)",
    "    {",
    "        if (string.IsNullOrWhiteSpace(raw))",
    "            continue;",
    "        string pulita = raw.Trim();",
    "        if (haFiltro && !pulita.Contains(chiave, StringComparison.OrdinalIgnoreCase))",
    "            continue;",
    "        filtrate.Add(pulita);",
    "    }",
    "",
    "    int totale = filtrate.Count;",
    "    if (totale == 0)",
    "        return \"pag 0/0 (0%): []\";",
    "",
    "    int totalePagine = (int)(((long)totale + perPagina - 1) / perPagina);",
    "    long inizio = (long)(pagina - 1) * perPagina;",
    "    if (pagina > totalePagine || inizio >= totale)",
    "        return $\"pag {pagina}/{totalePagine} (0%): []\";",
    "",
    "    int indiceInizio = (int)inizio;",
    "    int indiceFine = (int)Math.Min(inizio + perPagina, totale);",
    "    var paginaCorrente = new List<string>();",
    "    for (int i = indiceInizio; i < indiceFine; i++)",
    "        paginaCorrente.Add(filtrate[i]);",
    "",
    "    int mostrati = paginaCorrente.Count;",
    "    double quota = Math.Round(mostrati * 100.0 / totale, 1);",
    "    return $\"pag {pagina}/{totalePagine} ({quota}%): [{string.Join(\", \", paginaCorrente)}]\";",
    "}"
  ],
