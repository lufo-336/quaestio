{
  "id": "massimo-lista",
  "titolo": "Massimo di una lista",
  "livello": "base",
  "requisito": "Restituisce il valore massimo presente in una lista non vuota di numeri interi.",
  "chiamata": "Console.WriteLine(Massimo(new List<int> { -5, -2, -9 }));",
  "codiceSano": [
    "int Massimo(List<int> numeri)",
    "{",
    "    int max = numeri[0];",
    "    for (int i = 1; i < numeri.Count; i++)",
    "    {",
    "        if (numeri[i] > max)",
    "            max = numeri[i];",
    "    }",
    "    return max;",
    "}"
  ],
