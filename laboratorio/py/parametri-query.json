{
  "id": "parametri-query",
  "titolo": "Parsing di una query string",
  "livello": "media",
  "requisito": "Estrae un dizionario di coppie chiave=valore da una query string (se contiene '?', usa la parte dopo il primo '?'), ignorando segmenti senza '=' o con chiave vuota dopo il trim. Per le chiavi presenti in chiavi_intere converte il valore con int (lasciando propagare ValueError se non valido); se query è None o vuota restituisce {}.",
  "chiamata": "print(estrai_parametri(\"https://sito.it?pag=2&tag=py\", {\"pag\"}))\nprint(estrai_parametri(\"?token=ab=cd&&pag=10\", {\"pag\"}))\nprint(estrai_parametri(\"pag=abc&tag=web\", {\"pag\"}))",
  "codiceSano": [
    "def estrai_parametri(query, chiavi_intere):",
    "    if query is None or not query.strip():",
    "        return {}",
    "    testo = query.strip()",
    "    if \"?\" in testo:",
    "        testo = testo.split(\"?\", 1)[1]",
    "    risultato = {}",
    "    for blocco in testo.split(\"&\"):",
    "        if \"=\" not in blocco:",
    "            continue",
    "        chiave, val = blocco.split(\"=\", 1)",
    "        chiave = chiave.strip()",
    "        if not chiave:",
    "            continue",
    "        val = val.strip()",
    "        if chiavi_intere and chiave in chiavi_intere:",
    "            val = int(val)",
    "        risultato[chiave] = val",
    "    return risultato"
  ],
