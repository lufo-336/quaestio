{
  "id": "verifica-sla-servizi",
  "titolo": "Verifica SLA su log di richieste",
  "livello": "alta",
  "requisito": "Analizza una lista di dizionari evento (chiavi \"servizio\", \"stato\", \"ms\"): ignora voci None o con \"servizio\" vuoto/None; se critici non è None, considera solo i servizi in critici (ignorando spazi e maiuscole). Converte stato e ms con int(...) sollevando ValueError se non validi, stato < 100 o ms < 0. Restituisce \"non valido\" se eventi è None o soglia_ms <= 0; altrimenti restituisce totale validi, percentuale OK (stato < 500) arrotondata a 1 decimale e conteggio lenti (ms > soglia_ms).",
  "chiamata": "print(verifica_sla([{\"servizio\": \"Auth\", \"stato\": 200, \"ms\": 100}, {\"servizio\": \"auth\", \"stato\": 502, \"ms\": 50}, {\"servizio\": \"web\", \"stato\": 500, \"ms\": 20}, None], 100, [\"auth\"]))\nprint(verifica_sla([{\"servizio\": \"api\", \"stato\": s, \"ms\": 40} for s in [200, 200, 200, 500, 500, 500, 500, 500]], 100))\nprint(verifica_sla([{\"servizio\": \"auth\", \"stato\": 200, \"ms\": 30}, {\"servizio\": \"auth\", \"stato\": \"bad\", \"ms\": 20}], 100))",
  "codiceSano": [
    "def verifica_sla(eventi, soglia_ms, critici=None):",
    "    if eventi is None or soglia_ms <= 0:",
    "        return \"non valido\"",
    "    filtro = None",
    "    if critici is not None:",
    "        filtro = set()",
    "        for nome in critici:",
    "            if nome is not None and nome.strip():",
    "                filtro.add(nome.strip().lower())",
    "    totale = 0",
    "    ok = 0",
    "    lenti = 0",
    "    for rec in eventi:",
    "        if rec is None:",
    "            continue",
    "        srv_raw = rec.get(\"servizio\")",
    "        if srv_raw is None or not srv_raw.strip():",
    "            continue",
    "        srv = srv_raw.strip().lower()",
    "        if filtro is not None and srv not in filtro:",
    "            continue",
    "        stato_raw = rec.get(\"stato\")",
    "        ms_raw = rec.get(\"ms\")",
    "        if stato_raw is None or ms_raw is None:",
    "            raise ValueError(\"Campo mancante\")",
    "        stato = int(stato_raw)",
    "        ms = int(ms_raw)",
    "        if stato < 100 or ms < 0:",
    "            raise ValueError(\"Valore fuori scala\")",
    "        totale += 1",
    "        if stato < 500:",
    "            ok += 1",
    "        if ms > soglia_ms:",
    "            lenti += 1",
    "    if totale == 0:",
    "        return \"tot=0; ok=0.0%; lenti=0\"",
    "    tasso = round(ok * 100 / totale, 1)",
    "    return f\"tot={totale}; ok={tasso}%; lenti={lenti}\""
  ],
