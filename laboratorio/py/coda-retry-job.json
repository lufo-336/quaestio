{
  "id": "coda-retry-job",
  "titolo": "Coda lavori con tentativi di retry",
  "livello": "alta",
  "requisito": "Simula l'esecuzione di una lista di lavori (job_id, esiti) consentendo al più max_tentativi tentativi per lavoro (esiti validi \"OK\" o \"KO\", ignorando spazi e maiuscole; qualsiasi altro esito solleva ValueError). Ignora voci None, con job_id vuoto/None o esiti vuoti/None; se max_tentativi <= 0 o lavori è None restituisce \"non valido\". Registra in scarti (nuova lista se None) i job_id falliti e restituisce riusciti, falliti, media tentativi per lavoro elaborato (1 decimale) e la lista scarti.",
  "chiamata": "print(esegui_coda([(\"j1\", [\"KO\", \"KO\"]), (\"j2\", [\"OK\"])], 2))\nprint(esegui_coda([(\"j3\", [\"KO\", \"KO\", \"OK\"]), None, (\"j4\", [\"OK\"]), None], 2))\nprint(esegui_coda([(\"j5\", [\"OK\"]), None, (\"j6\", [\"KO\", \"BAD\"])], 2))",
  "codiceSano": [
    "def esegui_coda(lavori, max_tentativi, scarti=None):",
    "    if lavori is None or max_tentativi <= 0:",
    "        return \"non valido\"",
    "    if scarti is None:",
    "        scarti = []",
    "    riusciti = 0",
    "    falliti = 0",
    "    tentativi_tot = 0",
    "    for voce in lavori:",
    "        if voce is None or len(voce) != 2:",
    "            continue",
    "        job_id, esiti = voce",
    "        if not job_id or not job_id.strip() or not esiti:",
    "            continue",
    "        jid = job_id.strip()",
    "        completato = False",
    "        usati = 0",
    "        for raw in esiti:",
    "            if usati >= max_tentativi:",
    "                break",
    "            stato = (raw or \"\").strip().upper()",
    "            if stato != \"OK\" and stato != \"KO\":",
    "                raise ValueError(\"Esito non valido\")",
    "            usati += 1",
    "            if stato == \"OK\":",
    "                completato = True",
    "                break",
    "        tentativi_tot += usati",
    "        if completato:",
    "            riusciti += 1",
    "        else:",
    "            falliti += 1",
    "            scarti.append(jid)",
    "    processati = riusciti + falliti",
    "    if processati == 0:",
    "        media = 0.0",
    "    else:",
    "        media = round(tentativi_tot / processati, 1)",
    "    esito = f\"ok={riusciti}; ko={falliti}; med={media}\"",
    "    return f\"{esito}; scarti={scarti}\""
