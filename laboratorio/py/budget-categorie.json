  "requisito": "Dati un elenco di spese (categoria, importo), un dizionario limiti (chiavi in minuscolo -> budget) e soglia_min, somma gli importi positivi per categoria (rimuovendo spazi ai bordi e ignorando maiuscole/minuscole o voci con categoria None/vuota), scarta le categorie con totale < soglia_min e restituisce \"cat=N; oltre=M; tot=S\" (categorie rimaste, quante superano il rispettivo limite e totale speso); se spese è vuoto/None, limiti è None o soglia_min < 0 restituisce \"nessun dato\".",
  "chiamata": "print(riepilogo_budget([(\"Vitto\", 80), (\"vitto \", 40), (\"Viaggi\", 150)], {\"vitto\": 100, \"viaggi\": 200}, 50))\nprint(riepilogo_budget([(\"Vitto\", 50), (None, 30), (\"Tech\", 0), (\"Tech\", 80)], {\"vitto\": 50}, 20))\nprint(riepilogo_budget([(\"Vitto\", 100), (\"Cancelleria\", 15)], {\"vitto\": 90}, 30))",
  "codiceSano": [
    "def riepilogo_budget(spese, limiti, soglia_min):",
    "    if not spese or limiti is None or soglia_min < 0:",
    "        return \"nessun dato\"",
    "    totali = {}",
    "    for cat, importo in spese:",
    "        if cat is None or not cat.strip() or importo <= 0:",
    "            continue",
    "        chiave = cat.strip().lower()",
    "        totali[chiave] = totali.get(chiave, 0) + importo",
    "    for cat in list(totali):",
    "        if totali[cat] < soglia_min:",
    "            del totali[cat]",
    "    oltre = 0",
    "    somma = 0",
    "    for cat, tot in totali.items():",
    "        somma += tot",
    "        if cat in limiti and tot > limiti[cat]:",
    "            oltre += 1",
    "    return f\"cat={len(totali)}; oltre={oltre}; tot={somma}\""
