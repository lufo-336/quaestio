{
  "id": "normalizza-email",
  "titolo": "Normalizzazione elenco email",
  "livello": "base",
  "requisito": "Ripulisce una lista di indirizzi email togliendo gli spazi esterni, convertendo in minuscolo e scartando valori nulli, vuoti o duplicati, mantenendo l'ordine di arrivo.",
  "chiamata": "print(normalizza_email([\" Ana@X.it \", \"ana@x.it\", \"  \", \"BoB@y.it\"]))",
  "codiceSano": [
    "def normalizza_email(indirizzi):",
    "    risultato = []",
    "    visti = set()",
    "    for raw in indirizzi:",
    "        if raw is None:",
    "            continue",
    "        email = raw.strip().lower()",
    "        if email and email not in visti:",
    "            visti.add(email)",
    "            risultato.append(email)",
    "    return risultato"
  ],
