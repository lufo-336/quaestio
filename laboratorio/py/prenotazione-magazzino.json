  "requisito": "Elabora una lista di comandi (azione, sku, qta) sulle giacenze iniziali senza modificare il dizionario in ingresso, ignorando voci None, sku vuoti/None o qta <= 0 e sollevando ValueError per azioni diverse da PRENOTA e RILASCIA. PRENOTA scala la scorta se disponibile (>= qta) e aggiorna i prenotati; RILASCIA riesce solo se prenotato >= qta. Restituisce \"non valido\" se giacenze o ordini è None o soglia < 0; altrimenti restituisce evasi, rifiutati, totale unità ancora prenotate e SKU con scorta <= soglia.",
  "chiamata": "print(elabora_prenotazioni({\"A1\": 10, \"B2\": 4}, [(\"PRENOTA\", \"a1\", 4), (\"RILASCIA\", \"A1\", 1), (\"PRENOTA\", \"b2\", 4)], 2))\nprint(elabora_prenotazioni({\"A1\": 5, \"C3\": 2}, [(\"PRENOTA\", \"A1\", 2), (\"PRENOTA\", \"C3\", 4)], 3))\nprint(elabora_prenotazioni({\"A1\": 8}, [(\"PRENOTA\", \"A1\", 3), (\"RILASCIA\", \"A1\", 3)], 5))",
  "codiceSano": [
    "def elabora_prenotazioni(giacenze, ordini, soglia):",
    "    if giacenze is None or ordini is None or soglia < 0:",
    "        return \"non valido\"",
    "    scorte = {}",
    "    for k, v in giacenze.items():",
    "        if k is not None and k.strip() and v >= 0:",
    "            chiave = k.strip().upper()",
    "            scorte[chiave] = scorte.get(chiave, 0) + v",
    "    prenotati = {}",
    "    evasi = 0",
    "    rifiutati = 0",
    "    for voce in ordini:",
    "        if voce is None or len(voce) != 3:",
    "            continue",
    "        azione, sku, qta = voce",
    "        if sku is None or not sku.strip() or qta <= 0:",
    "            continue",
    "        op = (azione or \"\").strip().upper()",
    "        cod = sku.strip().upper()",
    "        if op == \"PRENOTA\":",
    "            if cod in scorte and scorte[cod] >= qta:",
    "                scorte[cod] -= qta",
    "                prenotati[cod] = prenotati.get(cod, 0) + qta",
    "                evasi += 1",
    "            else:",
    "                rifiutati += 1",
    "        elif op == \"RILASCIA\":",
    "            if cod in prenotati and prenotati[cod] >= qta:",
    "                prenotati[cod] -= qta",
    "                scorte[cod] = scorte.get(cod, 0) + qta",
    "                evasi += 1",
    "            else:",
    "                rifiutati += 1",
    "        else:",
    "            raise ValueError(\"Azione sconosciuta\")",
    "    for k in list(prenotati):",
    "        if prenotati[k] == 0:",
    "            del prenotati[k]",
    "    allerta = 0",
    "    for q in scorte.values():",
    "        if q <= soglia:",
    "            allerta += 1",
    "    tot_pren = sum(prenotati.values())",
    "    esito = f\"evasi={evasi}; rifiutati={rifiutati}\"",
    "    return f\"{esito}; pren={tot_pren}; allerta={allerta}\""
