<!-- Head WebAssembly per il browser. Sta fuori da Wsa.Quiz.sln apposta:
     cosi' la build della solution non richiede il workload wasm-tools. Comandi in
     docs/claude/piattaforme-e-distribuzione.md (sezione WebAssembly). -->
<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Wsa.Quiz.Browser</RootNamespace>
    <AssemblyName>Wsa.Quiz.Browser</AssemblyName>
    <WasmMainJSPath>wwwroot\main.js</WasmMainJSPath>
    <!-- L'SDK WebAssembly disabilita di default la reflection di System.Text.Json
         (causando JsonSerializerIsReflectionDisabled in StorageService.CaricaMaterie). -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.0.2" />
  </ItemGroup>

  <!-- Il trimming della publish Release taglia da Wsa.Quiz.Core cio' che
       System.Text.Json usa solo via reflection: la cronologia si caricava ma
       RisultatoQuiz.Dettagli restava vuota (dettaglio partita e Statistiche
       vuoti). Si tiene intera la libreria dei modelli/servizi. Trappola 27. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Wsa.Quiz.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\wsa.quiz.app\Wsa.Quiz.App.csproj" />
  </ItemGroup>

</Project>
